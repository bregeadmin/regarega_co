---
// Native app map «карта со шторкой-списком» — one component for both languages (pages
// app/map.astro and ru/app/map.astro render it with `lang`). Visual + motion source:
// rega-design-panel r4/final/map.html (map part) + shots 04–15.
// Full screen, no tab bar (AppFull): X · «карта / батуми · N мест» · list button, filter chips
// with category icons (?cat=<id> preselects one), Google map with our own HTML pins (world
// colour + category icon, filtered-out = grey grains, flats = orange price pills, «я» = blue dot
// only when location is ALREADY allowed), and a sheet with three positions: half (default) —
// the same detailed cards as the home «ещё рядом сейчас», full — the list, low — a strip.
// Tap a pin / card → that place in the sheet («подробнее» → its big card, «‹ все места»).
// Enter: circle reveal from the tapped button / tile (AppHeader saves it, styles/app-vt.css);
// leave by X or swipe-down on the header: reverse circle + history.back(), direct visit → home.
// Data is build-time; open-now runs client-side (public/app-hours.js, same as the home screen).
import AppFull from '../../layouts/AppFull.astro';
import '../../styles/app-shell.css';
import '../../styles/app-now.css';
import '../../styles/app-map.css';
import { supabase, applyNames, type Apartment } from '../../lib/supabase';
import { GMAPS_KEY } from '../../lib/maps';
import { GUIDE_CATS, WORLDS, catWorld, catIcon, catLabel, catColor, catStyle } from '../../lib/guideCats';
import { priceShort, priceFrom } from '../../lib/price';
import { thumb } from '../../lib/thumb';
import { placePhoto, placeWhy } from '../../lib/placeLine';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';

const T = isRu
  ? {
      title: 'карта — rega rega',
      desc: 'все проверенные квартиры и места, которые мы бы посоветовали другу, на одной карте.',
      map: 'карта', city: 'батуми', close: 'закрыть карту', list: 'список', listAria: 'показать список',
      filter: 'фильтр', all: 'всё', stays: 'жильё', me: 'где я', sheet: 'места на карте',
      fail: 'карта не загрузилась', failSub: 'список ниже работает — открой место, там адрес и маршрут',
    }
  : {
      title: 'map — rega rega',
      desc: "every checked apartment and every place we'd hand to a friend, on one map.",
      map: 'map', city: 'batumi', close: 'close the map', list: 'list', listAria: 'show the list',
      filter: 'filter', all: 'all', stays: 'stays', me: 'where am I', sheet: 'places on the map',
      fail: "the map didn't load", failSub: 'the list below still works — open a place for the address and directions',
    };

const { data: gp } = await supabase
  .from('guide_places')
  .select('slug,title,name,category,photos,image,hours,rating,take_title,body_ru,lat,lng')
  .eq('status', 'published');
const CAT_ORDER = ['eat-drink', 'wellness', 'move-around', 'work'];
const places = ((gp || []) as any[])
  .filter((p) => p.lat != null && p.lng != null && GUIDE_CATS[p.category])
  .sort((a, b) => (CAT_ORDER.indexOf(a.category) - CAT_ORDER.indexOf(b.category)) || ((b.rating || 0) - (a.rating || 0)));

const { data: aptData } = await supabase
  .from('apartments_public')
  .select('id,slug,title,bedrooms,max_guests,price_from,price_currency,photos,lat,lng')
  .order('price_from', { ascending: true });
const apartments = ((aptData as Apartment[]) || []).map(applyNames).filter((a) => a.lat != null && a.lng != null);

const flatSub = (a: any) => isRu
  ? (a.bedrooms === 0 ? 'студия' : `спален: ${a.bedrooms ?? 1}`) + ` · до ${a.max_guests ?? 2} гостей`
  : (a.bedrooms === 0 ? 'studio' : `${a.bedrooms ?? 1} bed`) + ` · up to ${a.max_guests ?? 2} guests`;

// what the client needs, nothing more (thumb 480 for list cards, 828 for the sheet card)
const DATA = {
  lang,
  base: BASE,
  key: GMAPS_KEY,
  places: places.map((p) => ({
    s: p.slug, n: p.title || p.name, k: p.category, c: catLabel(p.category, lang),
    la: +p.lat, lo: +p.lng, h: p.hours || [], w: placeWhy(p, lang),
    q: thumb(placePhoto(p), 480), P: thumb(placePhoto(p), 828),
  })),
  // flat names are ALWAYS English (applyNames); price as on the stays list (price.ts — markup already in the view)
  stays: apartments.map((a: any) => ({
    s: a.slug, n: a.title, la: +a.lat, lo: +a.lng, pr: priceShort(a) || '', pf: priceFrom(a, lang), sub: flatSub(a),
    q: thumb((a.photos && a.photos[0]) || '', 480), P: thumb((a.photos && a.photos[0]) || '', 828),
  })),
  // colour / stamp / icon per category — from guideCats.ts, never duplicated
  cats: Object.fromEntries(Object.keys(GUIDE_CATS).map((k) => [k, { c: catColor(k), st: catStyle(k), ic: catIcon(k), ln: !!GUIDE_CATS[k].outline }])),
};

// chips: all · categories in world order (only those with places) · stays
const counts: Record<string, number> = {};
places.forEach((p) => { counts[p.category] = (counts[p.category] || 0) + 1; });
const CHIPS = [...WORLDS].sort((a, b) => a.order - b.order)
  .flatMap((w) => Object.keys(GUIDE_CATS).filter((k) => catWorld(k) === w.id && counts[k]));
const chipLabel = (k: string) => isRu
  ? ({ 'eat-drink': 'еда', 'move-around': 'транспорт', wellness: 'велнес', work: 'работа' } as Record<string, string>)[k] || catLabel(k, lang)
  : ({ 'eat-drink': 'eat & drink', 'move-around': 'move around', wellness: 'wellness', work: 'work' } as Record<string, string>)[k] || catLabel(k, lang);
const plural = (n: number, a: string, b: string, c: string) => { const m = n % 10, h = n % 100; return m === 1 && h !== 11 ? a : m >= 2 && m <= 4 && (h < 10 || h >= 20) ? b : c; };
const nPlaces = places.length;
const topSub = isRu ? `${T.city} · ${nPlaces} ${plural(nPlaces, 'место', 'места', 'мест')}` : `${T.city} · ${nPlaces} places`;

// the punch-hole sign (logo) — flats carry the brand mark
const MARK = '<svg viewBox="0 0 100 100" aria-hidden="true"><path fill-rule="evenodd" fill="currentColor" d="M 50,50 m -50,0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0 z M 64,64 m -12,0 a 12,12 0 1,1 24,0 a 12,12 0 1,1 -24,0 z"/></svg>';
// Real Tabler-icons "outline" path data (viewBox 0 0 24 24).
const ICO = {
  x: '<path d="M18 6l-12 12" /><path d="M6 6l12 12" />',
  list: '<path d="M9 6l11 0" /><path d="M9 12l11 0" /><path d="M9 18l11 0" /><path d="M5 6l0 .01" /><path d="M5 12l0 .01" /><path d="M5 18l0 .01" />',
  loc: '<path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M12 12m-8 0a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" /><path d="M12 2l0 2" /><path d="M12 20l0 2" /><path d="M20 12l2 0" /><path d="M2 12l2 0" />',
  off: '<path d="M8.32 4.34l.68 -.34l6 3l6 -3v13m-2.67 1.33l-3.33 1.67l-6 -3l-6 3v-13l2.665 -1.333" /><path d="M9 4v1m0 4v8" /><path d="M15 7v4m0 4v5" /><path d="M3 3l18 18" />',
};
const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <script is:inline>
    // the map owns vertical drags: no native pull-to-refresh here (layouts: rrNoPullRefresh)
    document.documentElement.setAttribute('data-no-ptr', '');
    // circle reveal from the tapped button / tile (saved by AppHeader on the page we come from)
    (function () {
      var html = document.documentElement, from = null;
      try { from = JSON.parse(sessionStorage.getItem('rr_map_from') || 'null'); sessionStorage.removeItem('rr_map_from'); } catch (e) {}
      var st = history.state || {};
      var fresh = from && from.to === location.pathname && Date.now() - from.t < 6000;
      if (fresh) {
        // remember where we came from for the way out (survives a reload after «back» from a place)
        try { history.replaceState(Object.assign({}, st, { rrMapFrom: from }), ''); } catch (e) {}
      }
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition;
        if (!vt) return;
        var hush = function () {};
        vt.ready.catch(hush); vt.updateCallbackDone.catch(hush);
        if (!fresh) return;
        fresh = false;
        var W = innerWidth, H = innerHeight;
        var R = Math.hypot(Math.max(from.x, W - from.x), Math.max(from.y, H - from.y));
        html.style.setProperty('--rr-mx', from.x + 'px');
        html.style.setProperty('--rr-my', from.y + 'px');
        html.style.setProperty('--rr-mr', from.r + 'px');
        html.style.setProperty('--rr-mR', R + 'px');
        html.classList.add('rr-vt-map', 'rr-map-enter');
        var off = function () { html.classList.remove('rr-vt-map'); };
        vt.finished.then(off, off);
      });
    })();
  </script>

  <main class="mp" id="mp">
    <div class="mp-map" id="mpMap" aria-hidden="true"></div>
    <div class="mp-fail" id="mpFail" hidden>
      <span class="mp-fail__ic" set:html={svg(ICO.off)} />
      <b>{T.fail}</b>
      <span>{T.failSub}</span>
    </div>

    <div class="mp-top" id="mpTop">
      <div class="mp-bar" id="mpBar">
        <button class="mp-round mp-x" id="mpX" type="button" aria-label={T.close} set:html={svg(ICO.x)} />
        <div class="mp-t"><h1 class="now-display">{T.map}</h1><span class="mp-t__sub">{topSub}</span></div>
        <button class="mp-round mp-listbtn" id="mpListBtn" type="button" aria-label={T.listAria} aria-controls="mpSh" aria-pressed="false" set:html={svg(ICO.list)} />
      </div>
      <nav class="mp-chips" id="mpChips" aria-label={T.filter}>
        <button class="rr-chip mp-chip mp-chip--all is-active" type="button" data-f="all" aria-pressed="true">{T.all}</button>
        {CHIPS.map((k) => (
          <button class="rr-chip mp-chip" type="button" data-f={k} aria-pressed="false" style={catStyle(k)}>
            <span class={`mp-cico${GUIDE_CATS[k].outline ? ' is-ln' : ''}`} set:html={catIcon(k)} />{chipLabel(k)}
          </button>
        ))}
        {apartments.length > 0 && (
          <button class="rr-chip mp-chip" type="button" data-f="stay" aria-pressed="false">
            <span class="mp-cico mp-cico--home" set:html={MARK} />{T.stays}
          </button>
        )}
      </nav>
    </div>

    <section class="mp-sh" id="mpSh" role="region" aria-label={T.sheet} data-state="half">
      <button class="mp-round mp-me" id="mpMe" type="button" aria-label={T.me} set:html={svg(ICO.loc)} />
      <div class="mp-sh__h" id="mpShH">
        <i class="mp-sh__grip" aria-hidden="true"></i>
        <div class="mp-sh__row">
          <span class="mp-sh__tt"><b id="mpShN"></b><span class="mp-sh__sub" id="mpShSub"></span></span>
          <button class="mp-sh__up" id="mpShUp" type="button" tabindex="-1"><span set:html={svg(ICO.list)} />{T.list}</button>
        </div>
      </div>
      <div class="mp-sh__body">
        <div class="mp-sh__list" id="mpList"></div>
        <div class="mp-sh__det" id="mpDet" hidden></div>
      </div>
    </section>
    <div class="mp-toast" id="mpToast" role="status" aria-live="polite"></div>
  </main>

  <script is:inline src="/app-hours.js?v=1"></script>
  <script is:inline set:html={'window.RR_MAP=' + JSON.stringify(DATA).replace(/</g, '\\u003c') + ';'}></script>
  <script is:inline src="/app-map.js?v=2"></script>
</AppFull>
