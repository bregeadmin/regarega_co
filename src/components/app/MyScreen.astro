---
// «мой батуми» in the app — frame + tab bar around MyCore.astro (shared with the website's /saved).
import AppFull from '../../layouts/AppFull.astro';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import MyCore from './MyCore.astro';

export interface Props { lang: 'en' | 'ru'; city?: string }
const { lang, city = 'batumi' } = Astro.props;
const CITY = { batumi: { en: 'batumi', ru: 'батуми' } } as Record<string, { en: string; ru: string }>;
const cityName = (CITY[city] || { en: city, ru: city })[lang];
const T = lang === 'ru'
  ? { title: `мой ${cityName} — rega rega`, desc: `всё, что ты сохранил в ${cityName}: места, квартиры, новости.` }
  : { title: `my ${cityName} — rega rega`, desc: `everything you saved in ${cityName}: places, flats, news.` };
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <AppHeader lang={lang} />
  <MyCore lang={lang} city={city} mode="app" />
  <TabBar lang={lang} />
</AppFull>
