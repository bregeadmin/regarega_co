---
// «мой батуми» / «my batumi» — everything the guest saved with the mark in the corner of a card
// (public/app-saves.js → localStorage rr_saves, synced to the account when signed in). One
// component for both languages (pages app/my.astro). The saves live on the phone, so the list is
// drawn client-side from a build-time index of what can be saved (places, flats, news) — an item
// that is no longer published simply is not shown. Groups: flats (orange) first, then places by
// guide category (guideCats), then news. Tapping the mark again removes an item: it fades but
// stays in place until the screen is left, so a mistaken tap is undone with one more tap.
// Visual source: rega-design-panel r3/11-my-batumi.html.
import AppFull from '../../layouts/AppFull.astro';
import '../../styles/app-shell.css';
import '../../styles/app-my.css';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import { supabase, applyNames, type Apartment } from '../../lib/supabase';
import { catLabel, catColor, catStyle, newsStyle } from '../../lib/guideCats';
import { thumb } from '../../lib/thumb';
import { priceSym } from '../../lib/price';
import { loadNews, newsPhotos, newsText, newsDate, newsDay } from '../../lib/appNews';

export interface Props { lang: 'en' | 'ru'; city?: string }
const { lang, city = 'batumi' } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';
const CITY = { batumi: { en: 'batumi', ru: 'батуми' } } as Record<string, { en: string; ru: string }>;
const cityName = (CITY[city] || { en: city, ru: city })[lang];

const T = isRu
  ? {
      title: `мой ${cityName} — rega rega`, desc: `всё, что ты сохранил в ${cityName}: места, квартиры, новости.`,
      my: 'мой', sub: 'всё, что ты сохранил — места, квартиры, новости',
      stays: 'квартиры', news: 'новости', from: 'от', night: 'ночь',
      emptyH: 'тут пока пусто', emptyP: 'нажми на кружок в углу карточки гида, квартиры или новости — она появится здесь.',
      toGuide: 'открыть гид',
      local: 'пока сохранено только на этом телефоне.', signIn: 'войди по коду из письма', localTail: '— перенесём в аккаунт.',
      synced: 'сохранено в твоём аккаунте — будет на любом телефоне.',
    }
  : {
      title: `my ${cityName} — rega rega`, desc: `everything you saved in ${cityName}: places, flats, news.`,
      my: 'my', sub: 'everything you saved — places, flats, news',
      stays: 'flats', news: 'news', from: 'from', night: 'night',
      emptyH: 'nothing here yet', emptyP: 'tap the circle in the corner of a guide card, a flat or a news story — it shows up here.',
      toGuide: 'open the guide',
      local: 'saved on this phone only for now.', signIn: 'sign in with a code from your email', localTail: '— we’ll move it to your account.',
      synced: 'saved to your account — on any phone you sign in on.',
    };

// ---- build-time index of everything that can be saved ----
const areaOf = (a: string) => {
  const c = String(a || '').replace(/,?\s*Batumi[^,]*,?\s*Georgia\s*$/i, '').replace(/,\s*Georgia\s*$/i, '').trim();
  const f = (c.split(',')[0] || '').trim();
  if (!f || /^[A-Z0-9]{4,}\+[A-Z0-9]{2,}/.test(f) || /^\d+$/.test(f)) return '';
  return f.length > 26 ? f.slice(0, 26).replace(/\s+\S*$/, '') + '…' : f;
};
const { data: gp } = await supabase
  .from('guide_places').select('slug,title,name,category,photos,image,address').eq('status', 'published');
const { data: ap } = await supabase
  .from('apartments_public').select('id,slug,title,title_ru,neighborhood,bedrooms,max_guests,price_from,price_currency,photos');
const news = await loadNews();

const IDX: Record<string, any> = {};
((gp || []) as any[]).forEach((p) => {
  IDX['place:' + p.slug] = {
    n: p.title || p.name, q: thumb((p.photos && p.photos[0]) || p.image || '', 480), g: p.category,
    m: [catLabel(p.category, lang), areaOf(p.address)].filter(Boolean).join(' · '), h: `${BASE}/app/place/${p.slug}`,
  };
});
(((ap as Apartment[]) || []).map(applyNames)).forEach((a: any) => {
  IDX['stay:' + a.slug] = {
    n: String((isRu && a.title_ru) || a.title || '').toLowerCase(), q: thumb((a.photos && a.photos[0]) || '', 828),
    m: [a.neighborhood ? String(a.neighborhood).toLowerCase() : '', a.price_from ? `${T.from} ${priceSym(a.price_currency)}${a.price_from} / ${T.night}` : ''].filter(Boolean).join(' · '),
    h: `${BASE}/app/stays/${a.slug}`,
  };
});
news.forEach((n: any) => {
  const t = newsText(n, lang);
  IDX['news:' + n.slug] = {
    n: String(t.title || '').replace(/\*/g, ''), q: thumb(newsPhotos(n)[0] || '', 480),
    m: newsDate(n.date, lang) || newsDay(n.date), h: `${BASE}/app/news/${n.slug}`,
  };
});

// groups: flats → place categories (guide order) → news
const CAT_ORDER = ['eat-drink', 'wellness', 'move-around', 'work'];
const GROUPS = [
  { id: 'stay', label: T.stays, c: 'var(--home)', st: '' },
  ...CAT_ORDER.map((c) => ({ id: c, label: catLabel(c, lang), c: catColor(c), st: catStyle(c) })),
  { id: 'news', label: T.news, c: catColor('eat-drink'), st: newsStyle },
];
const MARK = 'M 50,50 m -50,0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0 z M 64,64 m -12,0 a 12,12 0 1,1 24,0 a 12,12 0 1,1 -24,0 z';
const loginHref = `${BASE}/app/login?next=${encodeURIComponent(BASE + '/app/my')}`;
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <AppHeader lang={lang} />
  <main class="my-screen">
    <header class="my-head">
      <h1 class="rr-display my-h">{T.my} <em>{cityName}</em><sup class="my-n" id="myN"></sup></h1>
      <p class="my-sub" id="mySub">{T.sub}</p>
    </header>

    <div id="myList" aria-live="polite"></div>

    <section class="my-empty" id="myEmpty" hidden>
      <svg class="my-empty__mark" viewBox="-6 -6 112 112" aria-hidden="true"><path fill-rule="evenodd" d={MARK} /></svg>
      <h2 class="rr-display my-empty__h">{T.emptyH}</h2>
      <p class="my-empty__p">{T.emptyP}</p>
      <a class="my-btn" href={`${BASE}/app/guide`}>{T.toGuide}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg></a>
    </section>

    <p class="my-sync" id="mySync" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2v-14z" /><path d="M11 4h2" /><path d="M12 17v.01" /></svg>
      <span id="mySyncLocal">{T.local} <a href={loginHref}>{T.signIn}</a> {T.localTail}</span>
      <span id="mySyncOk" hidden>{T.synced}</span>
    </p>
  </main>

  <TabBar lang={lang} />

  <script is:inline define:vars={{ IDX, GROUPS, CITY: city }}>
    (function () {
      var list = document.getElementById('myList');
      var shown = {}; // key → card element (kept while on screen, faded when removed)
      function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt) e.textContent = txt; return e; }
      function groupOf(x) { return x.k === 'stay' ? 'stay' : x.k === 'news' ? 'news' : (IDX['place:' + x.s] || {}).g; }

      function render() {
        var rs = window.rrSaves;
        var saves = rs ? rs.list(CITY) : [];
        list.textContent = ''; shown = {};
        var total = 0;
        GROUPS.forEach(function (g) {
          var its = saves.filter(function (x) { return IDX[x.k + ':' + x.s] && groupOf(x) === g.id; });
          if (!its.length) return;
          total += its.length;
          var sec = el('section', 'my-grp'); sec.setAttribute('data-g', g.id);
          var h = el('h2', 'my-grp__h');
          var dot = el('i', 'my-grp__dot'); dot.style.background = g.c; h.appendChild(dot);
          h.appendChild(document.createTextNode(g.label + ' '));
          var n = el('span', 'my-grp__n', String(its.length)); h.appendChild(n);
          sec.appendChild(h);
          var grid = el('div', 'my-grid' + (g.id === 'stay' || g.id === 'news' ? ' my-grid--wide' : ''));
          its.forEach(function (x) {
            var d = IDX[x.k + ':' + x.s];
            var a = el('a', 'my-it'); a.href = d.h;
            var ph = el('span', 'my-it__ph');
            if (d.q) { var im = document.createElement('img'); im.src = d.q; im.alt = ''; im.loading = 'lazy'; im.decoding = 'async'; im.onload = function () { im.classList.add('is-loaded'); }; ph.appendChild(im); }
            var b = el('button', 'rr-punch'); b.type = 'button';
            b.dataset.k = x.k; b.dataset.s = x.s; b.dataset.n = d.n; b.dataset.c = x.c || CITY;
            ph.appendChild(b);
            a.appendChild(ph);
            a.appendChild(el('b', 'my-it__name', d.n));
            if (d.m) a.appendChild(el('span', 'my-it__meta', d.m));
            grid.appendChild(a);
            shown[x.k + ':' + x.s] = a;
          });
          sec.appendChild(grid);
          list.appendChild(sec);
        });
        if (rs) rs.paint(list);
        counts(total);
      }
      function counts(total) {
        var rs = window.rrSaves;
        var live = rs ? rs.list(CITY).filter(function (x) { return IDX[x.k + ':' + x.s]; }).length : 0;
        document.getElementById('myN').textContent = live ? String(live) : '';
        var empty = !total;
        document.getElementById('myEmpty').hidden = !empty;
        document.getElementById('mySub').hidden = empty;
        // per group: how many are still saved
        [].forEach.call(list.querySelectorAll('.my-grp'), function (sec) {
          var n = sec.querySelectorAll('.rr-punch.is-on').length;
          sec.querySelector('.my-grp__n').textContent = String(n);
        });
      }
      function sync() {
        var rs = window.rrSaves, au = window.rrAuth;
        var box = document.getElementById('mySync');
        if (!rs || !au) return;
        au.session().then(function (s) {
          var ok = !!(s && rs.synced && rs.synced());
          document.getElementById('mySyncLocal').hidden = !!s; // signed in, RPCs not ready: say nothing wrong
          document.getElementById('mySyncOk').hidden = !ok;
          box.hidden = !!s && !ok;
        }).catch(function () {});
      }

      function onChange() {
        var rs = window.rrSaves; if (!rs) return;
        // a save we are not showing yet (account sync brought it) → draw again; else just fade / count
        var fresh = rs.list(CITY).some(function (x) { return IDX[x.k + ':' + x.s] && !shown[x.k + ':' + x.s]; });
        if (fresh) { render(); sync(); return; }
        Object.keys(shown).forEach(function (k) {
          var p = k.split(':');
          shown[k].classList.toggle('is-gone', !rs.has(p[0], p[1]));
        });
        counts(Object.keys(shown).length);
        sync();
      }
      function start() { render(); window.rrAuth ? sync() : addEventListener('rr-auth-ready', sync, { once: true }); }
      addEventListener('rr-saves', onChange);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true }); else start();
    })();
  </script>
</AppFull>
