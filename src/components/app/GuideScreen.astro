---
// Native app "guide" screen — one component for both languages (pages app/guide.astro and
// ru/app/guide.astro render it with `lang`). All published places as a 2-column grid with
// category chips, plus the city's news as part of the same guide (content is a filter
// inside the guide, not its own tab): "all" shows one news card on top — the nearest
// upcoming event, else the latest — and the "news" chip shows every item, upcoming first.
// "Upcoming" depends on today, so that choice runs client-side.
// Entry: `?cat=<slug>` (from the category tiles on «гид», or `?cat=news`) pre-selects that chip;
// an unknown slug falls back to «всё». The chosen chip is written back to the URL (replaceState),
// so «назад» from a place returns to the same filter. Visual source: r3/01-guide.html.
import App from '../../layouts/App.astro';
import '../../styles/app-guide.css';
import { supabase } from '../../lib/supabase';
import { catLabel, catColor, catStyle, newsStyle } from '../../lib/guideCats';
import { thumb } from '../../lib/thumb';
import Punch from './Punch.astro';
import { loadNews, newsPhotos, newsText, newsDate, newsDay } from '../../lib/appNews';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';

const T = isRu
  ? {
      title: 'гид — rega rega',
      desc: 'кафе, велнес, места для работы и как передвигаться по батуми — места, которые мы бы посоветовали другу.',
      cats: 'категории', all: 'всё', news: 'новости', empty: 'здесь пока пусто',
      read: 'читать',
      // заголовок по фильтру: курсивное слово — цвета категории
      h: {
        all: 'весь <em>гид</em>', 'eat-drink': 'есть <em>и</em> пить', wellness: '<em>велнес</em>',
        'move-around': '<em>передвижение</em>', work: 'работа <em>и</em> удалёнка', news: 'что <em>в городе</em>',
      },
      sub: { news: 'события и новости батуми' },
    }
  : {
      title: 'the guide — rega rega',
      desc: "cafés, wellness, work spots and how to get around batumi — places we'd hand to a friend.",
      cats: 'categories', all: 'all', news: 'news', empty: 'nothing here yet',
      read: 'read',
      h: {
        all: 'the whole <em>guide</em>', 'eat-drink': 'eat <em>&amp;</em> drink', wellness: '<em>wellness</em>',
        'move-around': 'move <em>around</em>', work: 'work <em>&amp;</em> remote', news: 'in <em>town</em>',
      },
      sub: { news: 'events and news in batumi' },
    };

const { data: gp } = await supabase
  .from('guide_places')
  .select('slug,title,name,category,photos,image,address')
  .eq('status', 'published');
const places = (gp || []) as any[];
const news = await loadNews();

// category chips: only worlds that actually have published places
const CAT_ORDER = ['eat-drink', 'wellness', 'move-around', 'work'];
const cats = CAT_ORDER.filter((c) => places.some((p) => p.category === c));

// heading colour per filter: the category world; news sit in the eat world (as on «гид»), all = ink
const ACCENT: Record<string, string> = Object.fromEntries(cats.map((c) => [c, catColor(c)]));
ACCENT.news = catColor('eat-drink');

const photoOf = (p: any) => (p.photos && p.photos[0]) || p.image || '';
// no dedicated "area" column on guide_places — derive a short area label from the street address
const areaOf = (p: any) => {
  const a = String(p.address || '').trim();
  if (!a) return '';
  const cleaned = a.replace(/,?\s*Batumi[^,]*,?\s*Georgia\s*$/i, '').replace(/,\s*Georgia\s*$/i, '').trim();
  const first = (cleaned.split(',')[0] || '').trim();
  // Google plus codes ("MPR4+FCW") are not an area
  if (!first || /^[A-Z0-9]{4,}\+[A-Z0-9]{2,}/.test(first) || /^\d+$/.test(first)) return '';
  // (a bare postcode like "6010" is not an area either)
  return first.length > 26 ? first.slice(0, 26).replace(/\s+\S*$/, '') + '…' : first;
};
// news headlines mark emphasis as *word* — render it as <em>
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const mdEm = (raw: string) => esc(raw).replace(/\*([^*]+)\*/g, '<em>$1</em>').replace(/\*/g, '');
---
<App lang={lang} title={T.title} description={T.desc}>
  <main class="gd-screen">
    <header class="gd-head" id="gdHead">
      <h1 class="rr-display gd-head__h" id="gdTitle" set:html={T.h.all} />
      <p class="gd-head__sub" id="gdSub"></p>
    </header>

    <nav class="gd-chips" aria-label={T.cats}>
      <button class="rr-chip is-active" data-cat="all" type="button">{T.all}</button>
      {cats.map((c) => (
        <button class="rr-chip" data-cat={c} type="button" style={catStyle(c)}><i></i>{catLabel(c, lang)}</button>
      ))}
      {news.length > 0 && <button class="rr-chip" data-cat="news" type="button" style={newsStyle}><i></i>{T.news}</button>}
    </nav>

    <div class="place-grid" id="placeGrid">
      {news.map((n) => {
        const t = newsText(n, lang);
        const photo = newsPhotos(n)[0];
        const when = newsDate(n.date, lang);
        return (
          <a class={`news-tile${photo ? '' : ' news-tile--plain'}`} data-day={newsDay(n.date)} href={`${BASE}/app/news/${n.slug}`} hidden>
            <span class="news-tile__body">
              <span>
                <span class="rr-tag news-tile__tag"><i></i><span>{T.news}{when ? ` · ${when}` : ''}</span></span>
                <span class="news-tile__title" set:html={mdEm(String(t.headline || t.title))} />
              </span>
              <span class="news-tile__read">{T.read}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6l-6 6" /></svg></span>
            </span>
            {photo && <span class="news-tile__photo"><img src={thumb(photo, 320)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" /></span>}
            <Punch k="news" s={n.slug} n={String(t.title || '').replace(/\*/g, '')} />
          </a>
        );
      })}
      {places.map((p) => {
        const photo = photoOf(p);
        const area = areaOf(p);
        return (
          <a class="place-tile" data-category={p.category} href={`${BASE}/app/place/${p.slug}`}>
            <span class="place-tile__photo">
              {photo && <img src={thumb(photo, 480)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" />}
              <Punch k="place" s={p.slug} n={p.title || p.name} />
            </span>
            <span class="rr-tag place-tile__tag" style={catStyle(p.category)}><i></i><span>{catLabel(p.category, lang)}</span></span>
            <span class="place-tile__name">{p.title || p.name}</span>
            <span class="place-tile__meta">{area}</span>
          </a>
        );
      })}
      <p class="place-grid__empty" id="placeGridEmpty" hidden>{T.empty}</p>
    </div>
  </main>

  <script is:inline define:vars={{ HEADS: T.h, ACCENT, RU: isRu, NEWS_SUB: T.sub.news }}>
    (function () {
      var grid = document.getElementById('placeGrid');
      var chips = document.querySelectorAll('.gd-chips .rr-chip');
      var tiles = document.querySelectorAll('.place-grid .place-tile');
      var empty = document.getElementById('placeGridEmpty');
      var title = document.getElementById('gdTitle');
      var sub = document.getElementById('gdSub');

      // news order: upcoming (soonest first), then past (latest first) — by Batumi date
      var today = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tbilisi' }));
      var t = today.getFullYear() + '-' + ('0' + (today.getMonth() + 1)).slice(-2) + '-' + ('0' + today.getDate()).slice(-2);
      var news = [].slice.call(grid.querySelectorAll('.news-tile'));
      var up = news.filter(function (n) { return n.dataset.day >= t; }).sort(function (a, b) { return a.dataset.day < b.dataset.day ? -1 : 1; });
      var past = news.filter(function (n) { return n.dataset.day < t; }).sort(function (a, b) { return a.dataset.day < b.dataset.day ? 1 : -1; });
      news = up.concat(past);
      news.slice().reverse().forEach(function (n) { grid.insertBefore(n, grid.firstChild); });
      if (news[0]) news[0].hidden = false;

      // «12 мест, куда мы ходим сами» / "12 places we go to ourselves"
      function count(n) {
        if (!RU) return n + (n === 1 ? ' place we go to ourselves' : ' places we go to ourselves');
        var m10 = n % 10, m100 = n % 100;
        var w = m10 === 1 && m100 !== 11 ? 'место' : (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? 'места' : 'мест');
        return n + ' ' + w + ', куда мы ходим сами';
      }

      function select(chip, user) {
        chips.forEach(function (c) { c.classList.remove('is-active'); });
        chip.classList.add('is-active');
        var cat = chip.getAttribute('data-cat');
        grid.setAttribute('data-cat', cat);
        var visible = 0;
        news.forEach(function (n, i) { n.hidden = cat === 'news' ? false : !(cat === 'all' && i === 0); });
        tiles.forEach(function (tl) {
          var match = cat === 'all' || tl.getAttribute('data-category') === cat;
          tl.classList.toggle('is-hidden', !match);
          if (match) visible++;
        });
        title.innerHTML = HEADS[cat] || HEADS.all;
        if (ACCENT[cat]) title.style.setProperty('--accent-c', ACCENT[cat]); else title.style.removeProperty('--accent-c');
        sub.textContent = cat === 'news' ? NEWS_SUB : count(visible);
        if (cat === 'news') visible = news.length;
        if (empty) empty.hidden = visible !== 0;
        if (user) {
          chip.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          try {
            var u = new URL(location.href);
            if (cat === 'all') u.searchParams.delete('cat'); else u.searchParams.set('cat', cat);
            history.replaceState(history.state, '', u.pathname + u.search + u.hash);
          } catch (e) {}
          window.scrollTo(0, 0);
        }
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () { select(chip, true); });
      });

      // ?cat=<slug> entry (category tiles on «гид»); unknown slug → «всё»
      var want = null;
      try { want = new URLSearchParams(location.search).get('cat'); } catch (e) {}
      var start = chips[0];
      chips.forEach(function (c) { if (want && c.getAttribute('data-cat') === want) start = c; });
      select(start, false);
      if (start !== chips[0]) {
        var row = start.parentNode;
        row.scrollLeft = Math.max(0, start.offsetLeft - 16);
      }
    })();
  </script>
</App>
