---
// Native app home screen «гид» — one component for both languages (pages app/now.astro and
// ru/app/now.astro just render it with `lang`). Visual source: rega-design-panel
// r4/final/map.html (the guide home) + r4/jhey/colors.html (tiles in rows by world).
// Top to bottom: city pill «батуми ▾» + live weather (Task 6 wires the city picker to
// #cityPill), a greeting by time of day whose italic word takes the hero's world colour,
// the hero — ONE confident pick for this moment, «ещё рядом сейчас» as up to 6 detailed
// cards, a compact strip of upcoming city news, and the category tiles in rows by world at
// the bottom (tap = the map filtered to that category; the orange tile = stays).
// The pick: Batumi time → a moment (morning / lunch / golden hour / evening / night) → guide
// places whose tags fit that moment AND are open now (Google hours from guide_places.hours)
// → one place, rotated daily. Data is build-time (static HTML); only the pick runs
// client-side, because it depends on the clock. Walking minutes only when there is an
// origin: the trip's apartment (html.has-trip) or geolocation the guest ALREADY granted
// (never prompts). Booking mode: a trip card under the greeting, the pick leans to what's
// near the apartment.
import AppFull from '../../layouts/AppFull.astro';
import '../../styles/app-shell.css';
import '../../styles/app-now.css';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import FirstRun from './FirstRun.astro';
import { supabase } from '../../lib/supabase';
import { GUIDE_CATS, WORLDS, catWorld, catIcon, catLabel, catColor, catStyle } from '../../lib/guideCats';
import { thumb } from '../../lib/thumb';
import { placePhoto, placeWhy } from '../../lib/placeLine';
import { loadNews, newsPhotos, newsText, newsDate, newsDay } from '../../lib/appNews';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';

const T = isRu
  ? {
      title: 'гид — rega rega',
      desc: 'батуми прямо сейчас — одно место под этот момент, что ещё открыто, категории гида и новости города.',
      city: 'батуми',
      cityAria: 'город: батуми',
      trip: 'твоя поездка',
      more: 'ещё рядом <em>сейчас</em>',
      news: 'новости',
      newsKick: 'скоро в городе',
      catsKick: 'категории · откроются на карте',
      cats: 'весь <em>батуми</em>',
      stayRow: 'жильё · бронь',
      stay: 'жить и оставаться',
      staySb: 'проверенные квартиры',
      onMap: 'на карте',
    }
  : {
      title: 'guide — rega rega',
      desc: 'batumi right now — one place for this moment, what else is open, the guide categories and city news.',
      city: 'batumi',
      cityAria: 'city: batumi',
      trip: 'your trip',
      more: 'more nearby <em>now</em>',
      news: 'news',
      newsKick: 'coming up in town',
      catsKick: 'categories · open on the map',
      cats: 'all of <em>batumi</em>',
      stayRow: 'stays · booking',
      stay: 'stay & live',
      staySb: 'flats we checked',
      onMap: 'on the map',
    };

// --- guide places ---
const { data: gp } = await supabase
  .from('guide_places')
  .select('slug,title,name,category,photos,image,address,hours,tags,rating,take_title,body_ru,lat,lng')
  .eq('status', 'published');
const gpAll = (gp || []) as any[];

const photoOf = placePhoto;
const whyOf = (p: any) => placeWhy(p, lang);

const CAT_ORDER = ['eat-drink', 'wellness', 'move-around', 'work'];
const withPhoto = gpAll
  .filter((p) => photoOf(p))
  .sort((a, b) => (CAT_ORDER.indexOf(a.category) - CAT_ORDER.indexOf(b.category)) || ((b.rating || 0) - (a.rating || 0)));

// what the client-side picker needs, nothing more (thumb widths: 828 hero, 480 list card)
const PICK_DATA = withPhoto.map((p) => ({
  s: p.slug,
  n: p.title || p.name,
  k: p.category,
  c: catLabel(p.category, lang),
  t: p.tags || [],
  h: p.hours || [],
  p: thumb(photoOf(p), 828),
  q: thumb(photoOf(p), 480),
  w: whyOf(p),
  la: p.lat,
  lo: p.lng,
}));
// category stamp vars + world colour for the client — from guideCats.ts, never duplicated
const CAT_STYLE = Object.fromEntries(Object.keys(GUIDE_CATS).map((k) => [k, { c: catColor(k), s: catStyle(k) }]));

// --- tiles: rows by world (WORLDS order), only categories that have places; stays first ---
const { data: apts } = await supabase.from('apartments_public').select('id');
const aptCount = (apts || []).length;
const counts: Record<string, number> = {};
gpAll.forEach((p) => { counts[p.category] = (counts[p.category] || 0) + 1; });
const ROWS = [...WORLDS]
  .sort((a, b) => a.order - b.order)
  .map((w) => ({ w, cats: Object.keys(GUIDE_CATS).filter((k) => catWorld(k) === w.id && counts[k]) }))
  .filter((r) => r.cats.length);

// Real Tabler-icons "outline" path data (viewBox 0 0 24 24).
const ICO = {
  chev: '<path d="M9 6l6 6l-6 6" />',
  down: '<path d="M6 9l6 6l6 -6" />',
  map: '<path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" /><path d="M9 4v13" /><path d="M15 7v5.5" /><path d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879z" /><path d="M19 18v.01" />',
};
// the punch-hole sign (logo) — the stays tile carries the brand mark, not a category icon
const MARK = '<svg viewBox="0 0 100 100" aria-hidden="true"><path fill-rule="evenodd" fill="currentColor" d="M 50,50 m -50,0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0 z M 64,64 m -12,0 a 12,12 0 1,1 24,0 a 12,12 0 1,1 -24,0 z"/></svg>';

// city events: rendered all, the client keeps only upcoming ones (today in Batumi or later)
const news = await loadNews();
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const mdEm = (raw: string) => esc(raw).replace(/\*([^*]+)\*/g, '<em>$1</em>').replace(/\*/g, '');
const eatC = catColor('eat-drink');
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <script is:inline define:vars={{ LANG: lang }}>
    // the app opens here: follow the language picked in the profile, else the phone's language
    try {
      var want = localStorage.getItem('rr_lang') || (/^ru/i.test(navigator.language || '') ? 'ru' : 'en');
      if (want !== LANG) location.replace(want === 'ru' ? '/ru/georgia/batumi/app/now' : '/georgia/batumi/app/now');
    } catch (e) {}
  </script>
  <!-- first launch only (rr_onboarded): splash → onboarding → this guide -->
  <FirstRun lang={lang} />
  <AppHeader lang={lang} />
  <main class="now-screen">
    <!-- city row under the logo: static pill (Task 6 opens the city picker from #cityPill) + weather -->
    <div class="now-crow">
      <button type="button" class="now-citypill" id="cityPill" aria-label={T.cityAria}>
        <span class="now-citypill__pin" aria-hidden="true"></span>{T.city}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICO.down} />
      </button>
      <span class="now-wx" id="nowWx" hidden><b id="nowTemp"></b> <span id="nowSky"></span></span>
    </div>

    <section class="now-hello">
      <h1 class="now-display now-hello__h" id="nowHello"></h1>
    </section>

    <a class="now-trip" id="nowTrip" href={`${BASE}/app/trip`}>
      <span class="now-trip__photo"><img id="nowTripImg" alt="" hidden /></span>
      <span class="now-trip__body">
        <span class="now-trip__kicker">{T.trip}</span>
        <span class="now-trip__name" id="nowTripName"></span>
        <span class="now-trip__status" id="nowTripStatus"></span>
      </span>
      <svg class="now-trip__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICO.chev} />
    </a>

    <a class="now-hero" id="nowHero" href={`${BASE}/app/guide`}>
      <img class="now-hero__img" id="nowHeroImg" alt="" onload="this.classList.add('is-loaded')" />
      <span class="now-hero__tags" id="nowHeroTags" hidden>
        <span class="now-tag now-tag--photo" id="nowHeroTag"><i></i><span id="nowHeroCat"></span></span>
        <span class="now-hero__pick" id="nowPick"></span>
      </span>
      <div class="now-hero__cap">
        <p class="now-display now-hero__name" id="nowName"></p>
        <p class="now-hero__ln"><span class="rr-open" id="nowOpen" hidden><i></i><span id="nowStatus"></span></span><span class="now-walk" id="nowWalk" hidden></span></p>
        <p class="now-hero__say" id="nowWhy"></p>
      </div>
    </a>

    <section class="now-more" id="nowMore" hidden>
      <div class="now-sec">
        <span class="now-kick" id="nowOpenN"></span>
        <h2 class="now-display now-sec__h" set:html={T.more} />
      </div>
      <div class="now-plist" id="nowList"></div>
    </section>

    <section class="now-town" id="nowTown" hidden>
      <div class="now-sec now-sec--small">
        <span class="now-kick">{T.news} · {T.newsKick}</span>
      </div>
      <div class="now-rail" id="nowTownRow">
        {news.map((n) => {
          const t = newsText(n, lang);
          const photo = newsPhotos(n)[0];
          return (
            <a class={`now-news${photo ? '' : ' now-news--plain'}`} data-day={newsDay(n.date)} href={`${BASE}/app/news/${n.slug}`} hidden>
              {photo && <span class="now-news__ph"><img src={thumb(photo, 320)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" /></span>}
              <span class="now-news__body">
                <span class="now-tag now-tag--news"><i></i>{newsDate(n.date, lang)}</span>
                <span class="now-news__title" set:html={mdEm(String(t.title))} />
              </span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="now-tiles" aria-labelledby="nowCatsH">
      <div class="now-sec">
        <span class="now-kick">{T.catsKick}</span>
        <h2 class="now-display now-sec__h" id="nowCatsH" style={`--accent-c:${eatC}`} set:html={T.cats} />
      </div>
      <div class="now-wl" style="--c:var(--home)">{T.stayRow}</div>
      <div class="now-g2">
        <a class="now-ct now-ct--fill now-ct--stay" style="--c:var(--home)" href={`${BASE}/app/stays`}>
          <span class="now-ct__top"><span class="now-ct__n">{aptCount || '—'}</span><span class="now-ct__ic now-ct__ic--mark" set:html={MARK} /></span>
          <span class="now-ct__h">{T.stay}</span>
          <span class="now-ct__sb">{T.staySb}</span>
        </a>
      </div>
      {ROWS.map(({ w, cats }) => (
        <Fragment>
          <div class="now-wl" style={`--c:${w.color}`}>{w.label[lang]}</div>
          <div class="now-g2">
            {cats.map((k, i) => (
              <a class={`now-ct now-ct--${i === 0 ? 'fill' : 'line'}`} style={`--c:${w.color}`} href={`${BASE}/app/map?cat=${k}`}>
                <span class="now-ct__top"><span class="now-ct__n">{counts[k]}</span><span class="now-ct__ic" set:html={catIcon(k)} /></span>
                <span class="now-ct__h">{catLabel(k, lang)}</span>
                <span class="now-ct__sb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICO.map} />{T.onMap}</span>
              </a>
            ))}
          </div>
        </Fragment>
      ))}
    </section>
  </main>

  <TabBar lang={lang} />

  <script is:inline src="/app-hours.js?v=1"></script>
  <script is:inline define:vars={{ PLACES: PICK_DATA, CATS: CAT_STYLE, LANG: lang, BASE }}>
    (function () {
      var RU = LANG === 'ru';
      // moment of the day (Batumi time) → which guide tags fit it + the hero's «why this» pill
      var MOMENTS = [
        { from: 0, to: 5, tags: ['Bars'], ru: 'ещё открыто', en: 'still open' },
        { from: 5, to: 11, tags: ['Coffee', 'Cafes'], ru: 'утром — сюда', en: 'for the morning' },
        { from: 11, to: 16, tags: ['Restaurants', 'Cafes', 'Asian dining', 'Dining Around Batumi', 'Gastro shops'], ru: 'на обед', en: 'for lunch' },
        { from: 16, to: 20, tags: ['Cafes', 'Bars', 'Coffee', 'Restaurants'], ru: 'на закат', en: 'for golden hour' },
        { from: 20, to: 24, tags: ['Bars', 'Restaurants'], ru: 'выбор на вечер', en: 'tonight’s pick' },
      ];
      // greeting by time of day (r3 onboarding/daily.html): the italic word takes the hero's colour
      var HELLO = [
        { from: 5, to: 11, ru: ['утро. куда', 'сначала?'], en: ['morning. where', 'first?'] },
        { from: 11, to: 17, ru: ['день. куда', 'выдохнуть?'], en: ['afternoon. where to', 'unwind?'] },
        { from: 17, to: 24, ru: ['вечер. куда', 'сейчас?'], en: ['evening. where', 'now?'] },
        { from: 0, to: 5, ru: ['ночь. что ещё', 'открыто?'], en: ['night. what’s', 'still open?'] },
      ];
      var $ = function (id) { return document.getElementById(id); };
      // «open now» from Google hours — shared with the map (public/app-hours.js)
      var H = window.rrHours, T0 = H.now();
      var now = T0.date, hour = T0.hour;
      var openNow = function (h) { return H.openNow(h, T0); };
      var statusText = function (o) { return H.status(o, RU); };
      var shortStatus = function (o) { return H.short(o, RU); };
      var catOf = function (k) { return CATS[k] || null; };
      var join = function (a, b) { return a && b ? a + ' · ' + b : a || b; };

      // walking minutes: from the trip's apartment door, or from where the guest is (only if
      // geolocation was ALREADY granted — never prompt). No origin → no minutes at all.
      var trip = window.rrTrip && window.rrTrip.active();
      var origin = trip && trip.apt && trip.apt.lat != null && trip.apt.lng != null ? trip.apt : null;
      var minsTo = function (la, lo) { return origin && window.rrTrip ? window.rrTrip.walkFrom(origin, la, lo) : null; };
      var walkTxt = function (la, lo) {
        var mn = minsTo(la, lo);
        if (mn == null) return '';
        if (mn <= 25) return RU ? mn + ' мин пешком' : mn + ' min walk';
        var km = (mn / 60) * 4.8 / 1.25, k = km < 10 ? km.toFixed(1) : String(Math.round(km));
        return RU ? k.replace('.', ',') + ' км' : k + ' km';
      };
      // every «· N min walk» slot carries data-la/data-lo; filled once an origin is known
      var fillWalks = function () {
        [].slice.call(document.querySelectorAll('.now-walk[data-la]')).forEach(function (w) {
          var t = walkTxt(parseFloat(w.dataset.la), parseFloat(w.dataset.lo));
          w.textContent = t; w.hidden = !t;
        });
      };
      if (trip) {
        $('nowTripName').textContent = trip.apt_title || trip.apt_name || '';
        $('nowTripStatus').textContent = window.rrTrip.status(trip, RU);
        if (trip.apt && trip.apt.photo) { $('nowTripImg').src = trip.apt.photo; $('nowTripImg').hidden = false; }
      }

      var m = MOMENTS.filter(function (x) { return hour >= x.from && hour < x.to; })[0];
      var fits = function (p) { return p.t.some(function (t) { return m.tags.indexOf(t) >= 0; }); };
      var scored = PLACES.map(function (p) { return { p: p, o: openNow(p.h) }; });
      // best: fits the moment and is open; then fits with unknown hours; then anything open
      var pool = scored.filter(function (x) { return fits(x.p) && x.o; });
      if (pool.length < 3) pool = pool.concat(scored.filter(function (x) { return fits(x.p) && x.o === null; }));
      if (pool.length < 3) pool = pool.concat(scored.filter(function (x) { return !fits(x.p) && x.o && pool.indexOf(x) < 0; }));
      if (!pool.length) pool = scored;
      // staying somewhere: keep the pick within a walk of the door when there's enough choice
      if (origin) {
        var near = pool.filter(function (x) { var mn = minsTo(x.p.la, x.p.lo); return mn != null && mn <= 15; });
        if (near.length >= 3) pool = near;
      }

      // rotate daily so the pick changes but stays stable within a day + moment
      var day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 864e5);
      var start = pool.length ? (day + MOMENTS.indexOf(m)) % pool.length : 0;
      var ordered = pool.slice(start).concat(pool.slice(0, start));
      var hero = ordered[0];
      var heroCat = hero && catOf(hero.p.k);
      // «ещё рядом сейчас»: the rest of the pick, topped up with other places open now — 6 at most
      var more = ordered.slice(1);
      scored.forEach(function (x) { if (x.o && x !== hero && more.indexOf(x) < 0) more.push(x); });
      more = more.slice(0, 6);
      var openCount = scored.filter(function (x) { return x.o; }).length;

      // greeting — two lines, the second in italic, coloured like the hero's world (ink if none)
      var hl = HELLO.filter(function (x) { return hour >= x.from && hour < x.to; })[0];
      var words = RU ? hl.ru : hl.en;
      var h1 = $('nowHello');
      h1.textContent = words[0];
      h1.appendChild(document.createElement('br'));
      var em = document.createElement('em'); em.textContent = words[1]; h1.appendChild(em);
      if (heroCat) { h1.style.setProperty('--accent-c', heroCat.c); $('nowMore').style.setProperty('--accent-c', heroCat.c); }

      if (hero) {
        $('nowHero').href = BASE + '/app/place/' + hero.p.s;
        $('nowHeroImg').src = hero.p.p;
        var nm = $('nowName');
        nm.textContent = hero.p.n;
        // long names step down so they stay on two lines at most
        var len = String(hero.p.n).length;
        if (len > 18) nm.classList.add('is-xlong'); else if (len > 11) nm.classList.add('is-long');
        if (hero.p.w) $('nowWhy').textContent = (RU ? '«' : '“') + hero.p.w + (RU ? '»' : '”');
        if (heroCat) $('nowHeroTag').setAttribute('style', heroCat.s);
        $('nowHeroCat').textContent = hero.p.c;
        $('nowPick').textContent = RU ? m.ru : m.en;
        $('nowHeroTags').hidden = false;
        var st = statusText(hero.o);
        if (st) { $('nowStatus').textContent = st; $('nowOpen').hidden = false; }
        $('nowWalk').dataset.la = hero.p.la; $('nowWalk').dataset.lo = hero.p.lo;
      }

      // detailed cards: photo large on the left, stamp, name, «until 23:00 · 7 min walk», one line why
      var list = $('nowList');
      var el = function (tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt) e.textContent = txt; return e; };
      more.forEach(function (x) {
        var a = el('a', 'now-pc'); a.href = BASE + '/app/place/' + x.p.s;
        var th = el('span', 'now-pc__th');
        var img = document.createElement('img'); img.src = x.p.q; img.alt = ''; img.loading = 'lazy'; img.decoding = 'async';
        img.onload = function () { img.classList.add('is-loaded'); };
        th.appendChild(img);
        var tx = el('span', 'now-pc__tx');
        var cs = catOf(x.p.k);
        var tag = el('span', 'now-tag'); if (cs) tag.setAttribute('style', cs.s);
        tag.appendChild(el('i')); tag.appendChild(document.createTextNode(x.p.c));
        var hrs = el('span', 'now-pc__hrs');
        var sh = shortStatus(x.o);
        if (sh) { var op = el('span', 'rr-open'); op.appendChild(el('i')); op.appendChild(document.createTextNode(sh)); hrs.appendChild(op); }
        var wk = el('span', 'now-walk'); wk.hidden = true; wk.dataset.la = x.p.la; wk.dataset.lo = x.p.lo; hrs.appendChild(wk);
        tx.appendChild(tag); tx.appendChild(el('b', 'now-pc__name', x.p.n)); tx.appendChild(hrs);
        if (x.p.w) tx.appendChild(el('span', 'now-pc__say', x.p.w));
        a.appendChild(th); a.appendChild(tx);
        list.appendChild(a);
      });
      if (list.children.length) {
        var n = openCount, a10 = n % 10, a100 = n % 100;
        $('nowOpenN').textContent = !n ? ''
          : RU ? 'сейчас открыто ' + n + ' ' + (a10 === 1 && a100 !== 11 ? 'место' : a10 >= 2 && a10 <= 4 && (a100 < 10 || a100 >= 20) ? 'места' : 'мест')
          : n + (n === 1 ? ' place' : ' places') + ' open now';
        $('nowMore').hidden = false;
      }
      // with an origin the list reads nearest first
      var sortByWalk = function () {
        [].slice.call(list.children)
          .map(function (c) { var w = c.querySelector('.now-walk'); return { c: c, k: minsTo(parseFloat(w.dataset.la), parseFloat(w.dataset.lo)) }; })
          .sort(function (x, y) { return (x.k == null ? 1e9 : x.k) - (y.k == null ? 1e9 : y.k); })
          .forEach(function (x) { list.appendChild(x.c); });
      };
      if (origin) { fillWalks(); sortByWalk(); }
      // no trip: if the guest already allowed location, measure from where they are (never prompts)
      else if (navigator.permissions && navigator.permissions.query && navigator.geolocation) {
        try {
          navigator.permissions.query({ name: 'geolocation' }).then(function (ps) {
            if (ps.state !== 'granted') return;
            navigator.geolocation.getCurrentPosition(function (pos) {
              origin = { lat: pos.coords.latitude, lng: pos.coords.longitude };
              // not in Batumi (city centre further than ~25 km on foot) — minutes would be noise
              if (minsTo(41.6508, 41.6357) > 300) { origin = null; return; }
              fillWalks(); // minutes only — no reorder after paint
            }, function () {}, { maximumAge: 600000, timeout: 8000 });
          }).catch(function () {});
        } catch (e) {}
      }

      // news: upcoming events only, soonest first, at most 6
      var today = now.getFullYear() + '-' + ('0' + (now.getMonth() + 1)).slice(-2) + '-' + ('0' + now.getDate()).slice(-2);
      var townRow = $('nowTownRow');
      var events = [].slice.call(townRow.querySelectorAll('.now-news'))
        .filter(function (e) { return e.dataset.day >= today; })
        .sort(function (a, b) { return a.dataset.day < b.dataset.day ? -1 : 1; })
        .slice(0, 6);
      events.forEach(function (e) { townRow.appendChild(e); e.hidden = false; });
      if (events.length) $('nowTown').hidden = false;
      if (events.length === 1) townRow.classList.add('is-single');

      // weather — Open-Meteo (no key, same source as the site's «right now» block).
      // Nothing is shown until real data arrives; offline → the line stays without a number.
      var SKY = RU
        ? [[0, 'ясно'], [3, 'облачно'], [48, 'туман'], [67, 'дождь'], [77, 'снег'], [82, 'ливень'], [99, 'гроза']]
        : [[0, 'clear'], [3, 'cloudy'], [48, 'fog'], [67, 'rain'], [77, 'snow'], [82, 'showers'], [99, 'storm']];
      var sky = function (code) { for (var i = 0; i < SKY.length; i++) if (code <= SKY[i][0]) return SKY[i][1]; return ''; };
      var deg = function (t) { var r = Math.round(t); return (r > 0 ? '+' : r < 0 ? '−' : '') + Math.abs(r) + '°'; };
      try {
        var LAT = 41.6508, LNG = 41.6357;
        var air = fetch('https://api.open-meteo.com/v1/forecast?latitude=' + LAT + '&longitude=' + LNG + '&current=temperature_2m,weather_code&timezone=Asia%2FTbilisi')
          .then(function (r) { return r.ok ? r.json() : null; });
        var sea = fetch('https://marine-api.open-meteo.com/v1/marine?latitude=' + LAT + '&longitude=' + LNG + '&current=sea_surface_temperature')
          .then(function (r) { return r.ok ? r.json() : null; }).catch(function () { return null; });
        Promise.all([air, sea]).then(function (res) {
          var c = res[0] && res[0].current;
          if (!c || typeof c.temperature_2m !== 'number') return;
          $('nowTemp').textContent = deg(c.temperature_2m);
          var s = res[1] && res[1].current && res[1].current.sea_surface_temperature;
          var seaTxt = typeof s === 'number' ? (RU ? 'море ' : 'sea ') + Math.round(s) + '°' : '';
          $('nowSky').textContent = join(sky(c.weather_code), seaTxt);
          $('nowWx').hidden = false;
        }).catch(function () {});
      } catch (e) {}
    })();
  </script>
