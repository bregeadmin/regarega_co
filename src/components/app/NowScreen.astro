---
// Native app "now" home screen — one component for both languages (pages
// app/now.astro and ru/app/now.astro just render it with `lang`).
// The hero is ONE confident pick for this moment: Batumi time → a moment (morning / lunch /
// golden hour / evening / night) → guide places whose tags fit that moment AND are open now
// (Google hours from guide_places.hours) → one place, rotated daily so it isn't always the
// same. Two alternatives sit under it; below — the whole guide (chips filter it) and stays.
// Data is build-time (static HTML); only the pick runs client-side, because it depends on
// the clock. Booking mode (html.has-trip): a trip card on top, the pick and the guide row
// lean to what's near the apartment and show the walk from its door, stays are hidden.
import AppFull from '../../layouts/AppFull.astro';
import '../../styles/app-shell.css';
import '../../styles/app-now.css';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import { supabase, applyNames, type Apartment } from '../../lib/supabase';
import { catLabel } from '../../lib/guideCats';
import { priceSym } from '../../lib/price';
import { thumb } from '../../lib/thumb';
import { loadNews, newsPhotos, newsText, newsDate, newsDay } from '../../lib/appNews';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';

const T = isRu
  ? {
      title: 'сейчас — rega rega',
      desc: 'батуми прямо сейчас — одно место под этот момент, весь гид и где остановиться.',
      or: 'или',
      town: 'в городе',
      trip: 'твоя поездка',
      guide: 'в гиде',
      stays: 'где остановиться',
      all: 'все →',
      allChip: 'всё',
      cats: 'категории',
      studio: 'студия',
      bedrooms: (n: number) => (n === 1 ? '1 спальня' : `${n} спальни`),
    }
  : {
      title: 'now — rega rega',
      desc: 'batumi right now — one place for this moment, the whole guide and where to stay.',
      or: 'or',
      town: 'in town',
      trip: 'your trip',
      guide: 'in the guide',
      stays: 'where to stay',
      all: 'all →',
      allChip: 'all',
      cats: 'categories',
      studio: 'studio',
      bedrooms: (n: number) => (n === 1 ? '1 bedroom' : `${n} bedrooms`),
    };

// --- guide places ---
const { data: gp } = await supabase
  .from('guide_places')
  .select('slug,title,name,category,photos,image,address,hours,tags,rating,take_title,body_ru,lat,lng')
  .eq('status', 'published');
const gpAll = (gp || []) as any[];

const photoOf = (p: any) => (p.photos && p.photos[0]) || p.image || '';
// no dedicated "area" column on guide_places — derive a short area label from the street address
const areaOf = (p: any) => {
  const a = String(p.address || '').trim();
  if (!a) return '';
  const cleaned = a.replace(/,?\s*Batumi[^,]*,?\s*Georgia\s*$/i, '').replace(/,\s*Georgia\s*$/i, '').trim();
  const first = (cleaned.split(',')[0] || '').trim();
  if (!first) return '';
  return first.length > 26 ? first.slice(0, 26).replace(/\s+\S*$/, '') + '…' : first;
};
// one line on why this place: the editorial take (EN) / first clause of the RU summary
const whyOf = (p: any) => {
  // (RU has no take yet — summary_ru often starts with hours, so use the body's first sentence)
  let raw = isRu ? String(p.body_ru || '').split(/(?<=[.!?])\s|\n/)[0] : String(p.take_title || '');
  // "garage wines — это винный бар…" → "винный бар…" (the name is already the headline)
  const name = String(p.title || p.name || '').toLowerCase().split(/\s+/)[0];
  if (isRu && name && raw.toLowerCase().startsWith(name) && raw.includes(' — ')) raw = raw.slice(raw.indexOf(' — ') + 3).replace(/^это\s+/i, '');
  const clean = raw.replace(/\*+/g, '').replace(/\s+/g, ' ').replace(/[.]$/, '').trim();
  return clean.length > 120 ? clean.slice(0, 120).replace(/\s+\S*$/, '') + '…' : clean;
};

const CAT_ORDER = ['eat-drink', 'wellness', 'move-around', 'work'];
const cats = CAT_ORDER.filter((c) => gpAll.some((p) => p.category === c));
// guide row order: category order first (food before transport), then rating
const withPhoto = gpAll
  .filter((p) => photoOf(p))
  .sort((a, b) => (CAT_ORDER.indexOf(a.category) - CAT_ORDER.indexOf(b.category)) || ((b.rating || 0) - (a.rating || 0)));

// what the client-side picker needs, nothing more
const PICK_DATA = withPhoto.map((p) => ({
  s: p.slug,
  n: p.title || p.name,
  c: catLabel(p.category, lang),
  t: p.tags || [],
  h: p.hours || [],
  p: thumb(photoOf(p), 828),
  q: thumb(photoOf(p), 320),
  w: whyOf(p),
  la: p.lat,
  lo: p.lng,
}));

// --- apartments: cheapest first, with a real photo ---
const { data: apts } = await supabase
  .from('apartments_public')
  .select('id,slug,title,title_ru,neighborhood,bedrooms,max_guests,price_from,price_currency,photos')
  .order('price_from', { ascending: true });
const apartments = ((apts as Apartment[]) || [])
  .map(applyNames)
  .map((a: any) => ({ ...a, title: (isRu && a.title_ru) || a.title }))
  .filter((a) => a.photos && a.photos[0])
  .slice(0, 6);
// city events: rendered all, the client keeps only upcoming ones (today in Batumi or later)
const news = await loadNews();
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const mdEm = (raw: string) => esc(raw).replace(/\*([^*]+)\*/g, '<em>$1</em>').replace(/\*/g, '');

const bedroomLabel = (n: number | null | undefined) => (!n ? T.studio : T.bedrooms(n));
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <script is:inline define:vars={{ LANG: lang }}>
    // the app opens here: follow the language picked in the profile, else the phone's language
    try {
      var want = localStorage.getItem('rr_lang') || (/^ru/i.test(navigator.language || '') ? 'ru' : 'en');
      if (want !== LANG) location.replace(want === 'ru' ? '/ru/georgia/batumi/app/now' : '/georgia/batumi/app/now');
    } catch (e) {}
  </script>
  <AppHeader lang={lang} />
  <main class="now-screen">
    <a class="now-trip" id="nowTrip" href={`${BASE}/app/trip`}>
      <span class="now-trip__photo"><img id="nowTripImg" alt="" hidden /></span>
      <span class="now-trip__body">
        <span class="now-trip__kicker">{T.trip}</span>
        <span class="now-trip__name" id="nowTripName"></span>
        <span class="now-trip__status" id="nowTripStatus"></span>
      </span>
      <svg class="now-trip__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6l-6 6" /></svg>
    </a>

    <a class="now-hero" id="nowHero" href={`${BASE}/app/guide`}>
      <img class="now-hero__img" id="nowHeroImg" alt="" onload="this.classList.add('is-loaded')" />
      <div class="now-hero__scrim">
        <p class="now-hero__overline" id="nowOverline">rega standard</p>
        <h1 class="now-hero__headline" id="nowHeadline"></h1>
        <p class="now-hero__name" id="nowName"></p>
        <p class="now-hero__why" id="nowWhy"></p>
        <p class="now-hero__status" id="nowStatus" hidden></p>
      </div>
    </a>

    <div class="now-alts" id="nowAlts" hidden>
      <p class="now-alts__label">{T.or}</p>
      <div class="now-alts__row" id="nowAltsRow"></div>
    </div>

    <section class="now-block">
      <div class="now-block__head">
        <h2 class="now-block__title">{T.guide}</h2>
        <a class="now-block__all" href={`${BASE}/app/guide`}>{T.all}</a>
      </div>
      <nav class="now-chips" aria-label={T.cats}>
        <button class="now-chip is-active" data-cat="all" type="button">{T.allChip}</button>
        {cats.map((c) => (
          <button class="now-chip" data-cat={c} type="button">{catLabel(c, lang)}</button>
        ))}
      </nav>
      <div class="now-scroller" id="nowPlaces">
        {withPhoto.map((p) => {
          const area = areaOf(p);
          return (
            <a class="now-placecard" data-category={p.category} data-lat={p.lat} data-lng={p.lng} href={`${BASE}/app/place/${p.slug}`}>
              <div class="now-placecard__photo"><img src={thumb(photoOf(p), 320)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" /></div>
              <p class="now-placecard__name">{p.title || p.name}</p>
              <p class="now-placecard__meta" data-cat={catLabel(p.category, lang)}>{catLabel(p.category, lang)}{area ? ` · ${area}` : ''}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section class="now-block" id="nowTown" hidden>
      <div class="now-block__head">
        <h2 class="now-block__title">{T.town}</h2>
      </div>
      <div class="now-scroller" id="nowTownRow">
        {news.map((n) => {
          const t = newsText(n, lang);
          const photo = newsPhotos(n)[0];
          return (
            <a class={`now-event${photo ? '' : ' now-event--plain'}`} data-day={newsDay(n.date)} href={`${BASE}/app/news/${n.slug}`} hidden>
              {photo && <div class="now-event__photo"><img src={thumb(photo, 480)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" /></div>}
              <p class="now-event__when">{newsDate(n.date, lang)}</p>
              <p class="now-event__title" set:html={mdEm(String(t.title))} />
            </a>
          );
        })}
      </div>
    </section>

    <section class="now-block now-stays">
      <div class="now-block__head">
        <h2 class="now-block__title">{T.stays}</h2>
        <a class="now-block__all" href={`${BASE}/app/stays`}>{T.all}</a>
      </div>
      <div class="now-scroller now-scroller--stays">
        {apartments.map((a) => (
          <a class="now-staycard" href={`${BASE}/app/stays/${a.slug}`}>
            <div class="now-staycard__photo"><img src={thumb(a.photos[0], 480)} alt="" loading="lazy" onload="this.classList.add('is-loaded')" /></div>
            <div class="now-staycard__row">
              <span class="now-staycard__name">{a.title}</span>
              <span class="now-staycard__price">{priceSym(a.price_currency)}{a.price_from}</span>
            </div>
            <p class="now-staycard__meta">{bedroomLabel(a.bedrooms)}{a.neighborhood ? ` · ${a.neighborhood}` : ''}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <TabBar lang={lang} />

  <script is:inline define:vars={{ PLACES: PICK_DATA, LANG: lang, BASE }}>
    (function () {
      var RU = LANG === 'ru';
      // moment of the day (Batumi time) → which guide tags fit it
      var MOMENTS = [
        { from: 0, to: 5, tags: ['Bars'], ru: ['ночь', 'ещё открыто.'], en: ['night', 'still open.'] },
        { from: 5, to: 11, tags: ['Coffee', 'Cafes'], ru: ['утро', 'начни с кофе.'], en: ['morning', 'start with coffee.'] },
        { from: 11, to: 16, tags: ['Restaurants', 'Cafes', 'Asian dining', 'Dining Around Batumi', 'Gastro shops'], ru: ['день', 'время обеда.'], en: ['afternoon', 'time for lunch.'] },
        { from: 16, to: 20, tags: ['Cafes', 'Bars', 'Coffee', 'Restaurants'], ru: ['золотой час', 'успей до заката.'], en: ['golden hour', 'catch the light.'] },
        { from: 20, to: 24, tags: ['Bars', 'Restaurants'], ru: ['вечер', 'куда пойти вечером.'], en: ['evening', 'where to tonight.'] },
      ];
      var $ = function (id) { return document.getElementById(id); };
      var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tbilisi' }));
      var hour = now.getHours(), dow = now.getDay(), mins = hour * 60 + now.getMinutes();

      // Google hours: "10:00 AM - 10:00 PM", "12:00 - 10:45 PM" (suffix only on the close), "Open 24 hours", "Closed"
      function pt(s, fallback) {
        var m = String(s).match(/(\d{1,2}):(\d{2})\s*(AM|PM)?/i); if (!m) return null;
        var suf = m[3] || fallback; var h = +m[1];
        if (suf) { h = h % 12; if (/pm/i.test(suf)) h += 12; }
        return h * 60 + (+m[2]);
      }
      function ranges(str) {
        if (!str || /closed/i.test(str)) return [];
        if (/24/.test(str) && /hour/i.test(str)) return [{ o: 0, c: 1440, all: true }];
        return str.split(',').map(function (r) {
          var p = r.split(/[–—-]/); if (p.length < 2) return null;
          var suf = (p[1].match(/(AM|PM)/i) || [])[1];
          var o = pt(p[0], suf), c = pt(p[1]); if (o == null || c == null) return null;
          if (c <= o) c += 1440; return { o: o, c: c };
        }).filter(Boolean);
      }
      function dayStr(hours, d) {
        for (var i = 0; i < hours.length; i++) { var l = hours[i], k = l.indexOf(':'); if (k > 0 && l.slice(0, k).trim() === DAYS[d]) return l.slice(k + 1).trim(); }
        return '';
      }
      // → null (no hours known), false (closed), or { all } / { close: minutes-of-day }
      function openNow(hours) {
        if (!hours || !hours.length) return null;
        var today = ranges(dayStr(hours, dow)), yest = ranges(dayStr(hours, (dow + 6) % 7));
        for (var i = 0; i < today.length; i++) if (mins >= today[i].o && mins < today[i].c) return today[i].all ? { all: true } : { close: today[i].c % 1440 };
        for (var j = 0; j < yest.length; j++) if (mins + 1440 >= yest[j].o && mins + 1440 < yest[j].c) return { close: yest[j].c % 1440 };
        return false;
      }
      function hhmm(m) { return ('0' + Math.floor(m / 60)).slice(-2) + ':' + ('0' + (m % 60)).slice(-2); }
      function statusText(o) {
        if (!o) return '';
        if (o.all) return RU ? 'открыто круглосуточно' : 'open 24 hours';
        return (RU ? 'открыто до ' : 'open till ') + hhmm(o.close);
      }

      // booking mode: walk from the apartment door ('' outside booking mode)
      var trip = window.rrTrip && window.rrTrip.active();
      var walk = function (lat, lng) { return trip ? window.rrTrip.from(lat, lng, RU) : ''; };
      var join = function (a, b) { return a && b ? a + ' · ' + b : a || b; };
      if (trip) {
        $('nowTripName').textContent = trip.apt_title || trip.apt_name || '';
        $('nowTripStatus').textContent = window.rrTrip.status(trip, RU);
        if (trip.apt && trip.apt.photo) { $('nowTripImg').src = trip.apt.photo; $('nowTripImg').hidden = false; }
      }

      var m = MOMENTS.filter(function (x) { return hour >= x.from && hour < x.to; })[0];
      var fits = function (p) { return p.t.some(function (t) { return m.tags.indexOf(t) >= 0; }); };
      var scored = PLACES.map(function (p) { return { p: p, o: openNow(p.h) }; });
      // best: fits the moment and is open; then fits with unknown hours; then anything open
      var pool = scored.filter(function (x) { return fits(x.p) && x.o; });
      if (pool.length < 3) pool = pool.concat(scored.filter(function (x) { return fits(x.p) && x.o === null; }));
      if (pool.length < 3) pool = pool.concat(scored.filter(function (x) { return !fits(x.p) && x.o && pool.indexOf(x) < 0; }));
      if (!pool.length) pool = scored;
      // staying somewhere: keep the pick within a walk of the door when there's enough choice
      if (trip) {
        var near = pool.filter(function (x) { var mn = window.rrTrip.minutes(x.p.la, x.p.lo); return mn != null && mn <= 15; });
        if (near.length >= 3) pool = near;
      }

      // rotate daily so the pick changes but stays stable within a day + moment
      var day = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 864e5);
      var start = (day + MOMENTS.indexOf(m)) % pool.length;
      var picks = pool.slice(start).concat(pool.slice(0, start)).slice(0, 3);

      var words = RU ? m.ru : m.en;
      var hero = picks[0];
      $('nowOverline').textContent = words[0] + ' · rega standard';
      $('nowHeadline').textContent = words[1];
      if (hero) {
        $('nowHero').href = BASE + '/app/place/' + hero.p.s;
        $('nowHeroImg').src = hero.p.p;
        $('nowName').textContent = hero.p.n;
        $('nowWhy').textContent = hero.p.w;
        var st = join(statusText(hero.o), walk(hero.p.la, hero.p.lo));
        if (st) { $('nowStatus').textContent = st; $('nowStatus').hidden = false; }
      }

      var row = $('nowAltsRow');
      picks.slice(1).forEach(function (x) {
        var a = document.createElement('a');
        a.className = 'now-alt';
        a.href = BASE + '/app/place/' + x.p.s;
        var ph = document.createElement('span'); ph.className = 'now-alt__photo';
        var img = document.createElement('img'); img.src = x.p.q; img.alt = ''; ph.appendChild(img);
        var body = document.createElement('span'); body.className = 'now-alt__body';
        var nm = document.createElement('span'); nm.className = 'now-alt__name'; nm.textContent = x.p.n;
        var meta = document.createElement('span'); meta.className = 'now-alt__meta'; meta.textContent = walk(x.p.la, x.p.lo) || statusText(x.o) || x.p.c;
        body.appendChild(nm); body.appendChild(meta);
        a.appendChild(ph); a.appendChild(body);
        row.appendChild(a);
      });
      if (row.children.length) $('nowAlts').hidden = false;

      // in town: upcoming events only, soonest first, at most 6
      var today = now.getFullYear() + '-' + ('0' + (now.getMonth() + 1)).slice(-2) + '-' + ('0' + now.getDate()).slice(-2);
      var townRow = $('nowTownRow');
      var events = [].slice.call(townRow.querySelectorAll('.now-event'))
        .filter(function (e) { return e.dataset.day >= today; })
        .sort(function (a, b) { return a.dataset.day < b.dataset.day ? -1 : 1; })
        .slice(0, 6);
      events.forEach(function (e) { townRow.appendChild(e); e.hidden = false; });
      if (events.length) $('nowTown').hidden = false;

      // booking mode: the guide row shows the walk from the door, nearest first
      if (trip) {
        var placesRow = $('nowPlaces');
        [].slice.call(placesRow.querySelectorAll('.now-placecard'))
          .map(function (c) {
            var la = parseFloat(c.dataset.lat), lo = parseFloat(c.dataset.lng);
            var w = isNaN(la) ? '' : walk(la, lo);
            var meta = c.querySelector('.now-placecard__meta');
            if (w) meta.textContent = meta.dataset.cat + ' · ' + w;
            var a = trip.apt || {};
            return { c: c, k: isNaN(la) || a.lat == null ? 1e9 : Math.pow(la - a.lat, 2) + Math.pow((lo - a.lng) * Math.cos(a.lat * Math.PI / 180), 2) };
          })
          .sort(function (x, y) { return x.k - y.k; })
          .forEach(function (x) { placesRow.appendChild(x.c); });
      }

      // category chips filter the guide row
      var chips = document.querySelectorAll('.now-chip');
      var cards = document.querySelectorAll('#nowPlaces .now-placecard');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          chips.forEach(function (c) { c.classList.remove('is-active'); });
          chip.classList.add('is-active');
          var cat = chip.getAttribute('data-cat');
          cards.forEach(function (c) { c.hidden = !(cat === 'all' || c.getAttribute('data-category') === cat); });
          $('nowPlaces').scrollLeft = 0;
        });
      });
    })();
  </script>
</AppFull>
