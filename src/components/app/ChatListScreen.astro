---
// Native app "messages" — the guest's conversations with hosts. Opened from the profile. The list
// itself (markup + script) is ChatListCore.astro, shared with the website's messages page.
import AppFull from '../../layouts/AppFull.astro';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import ChatListCore from './ChatListCore.astro';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const T = lang === 'ru'
  ? { title: 'сообщения — rega rega', desc: 'переписка с хозяевами квартир.' }
  : { title: 'messages — rega rega', desc: 'your conversations with hosts.' };
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <AppHeader lang={lang} />
  <main class="ml-screen">
    <ChatListCore lang={lang} mode="app" />
  </main>
  <TabBar lang={lang} />
</AppFull>
