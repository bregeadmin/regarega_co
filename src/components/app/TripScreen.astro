---
// Native app "trip" screen — one component for both languages (pages app/trip.astro and
// ru/app/trip.astro). Visual source: rega-design-panel r3/03-trip.html (orange = the «home» world).
// Everything is per-device and per-booking, so it all runs client-side:
// token from ?t= / the pasted host link / localStorage rr_trip_token → two anon RPCs that
// already exist (guest_instruction: dates, steps, codes gated to ci-2…co+1, wifi, operator;
// guest_guide: the apartment's slug + coordinates) + the apartment photo → cached as
// localStorage rr_trip (works offline, and switches the whole app into booking mode —
// see TripFlag.astro). States: empty (paste the link) · loading · the trip · pending (request
// not confirmed yet: hero + status line only) · past (trip over: no codes/steps) · link failed.
// Signed in (window.rrAuth): a ?t= link is claimed onto the account once per token per device
// (rr_claimed); /app/trip with nothing on the phone picks a trip from the account (my_trips);
// the owner can invite a companion; mode="join" (app/trip/join) accepts an invite (?i=).
// Signed out = the plain anonymous flow, untouched.
// The status line (заявка → бронь → заезд → в квартире → выезд) uses the same dot vocabulary
// as the booking track on 08 (StayScreen): done = filled orange, now = orange ring + dot.
// No «улучши поездку» block: there are no add-on services in the data yet (r3 shows fake ones).
// «написать хозяину» does not exist yet (messaging = stage 4), so it isn't drawn.
import AppFull from '../../layouts/AppFull.astro';
import '../../styles/app-shell.css';
import '../../styles/app-trip.css';
import AppHeader from '../AppHeader.astro';
import TabBar from '../TabBar.astro';
import { supabase } from '../../lib/supabase';
import { GUIDE_CATS, catLabel, catColor, catTint, catDark, catOutline, catStyle } from '../../lib/guideCats';
import { thumb } from '../../lib/thumb';
import { icon } from '../../lib/stayUi';

export interface Props { lang: 'en' | 'ru'; mode?: 'trip' | 'join' }
const { lang, mode = 'trip' } = Astro.props;
const isRu = lang === 'ru';
const BASE = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';

const T = isRu
  ? {
      title: 'поездка — rega rega', desc: 'твоя бронь, коды и wifi — в одном месте.',
      emptyH: 'твоя поездка<br><em>появится здесь</em>',
      emptyP: 'открой ссылку на бронь из сообщения хозяина — или вставь её сюда.',
      field: 'ссылка или код брони', open: 'открыть', stays: 'смотреть жильё',
      bad: 'не нашли такую бронь — проверь ссылку из сообщения.',
      offline: 'нет сети — нужна связь, чтобы открыть бронь.',
      loading: 'открываем поездку…',
      how: 'как <em>попасть</em>', wifi: 'wifi', pass: 'пароль', addr: 'адрес', route: 'как добраться', mapOpen: 'открыть на карте',
      parking: 'парковка', out: 'при выезде', full: 'инструкция',
      copy: 'копировать', copied: 'скопировано', cached: 'сохранённая копия — нет сети',
      forget: 'убрать поездку с этого телефона', forgetSure: 'точно убрать? нажми ещё раз',
      pending: 'ждём подтверждения', pendingP: 'коды и wifi появятся, когда хозяин подтвердит бронь.',
      taken: 'эта бронь уже добавлена в другой аккаунт.',
      invite: 'добавить спутника', inviteP: 'пришлём ссылку — поездка откроется и у твоего спутника',
      inviteCopied: 'ссылка-приглашение скопирована', inviteErr: 'не получилось создать приглашение — попробуй ещё раз.',
      joining: 'добавляем поездку…', toTrip: 'к моей поездке',
      jUsed: 'это приглашение уже использовано.', jExpired: 'срок приглашения истёк — попроси новое.',
      jOwn: 'это твоя бронь — приглашение нужно отправить спутнику.', jNotFound: 'приглашение не найдено — проверь ссылку.',
      jNet: 'нет связи — попробуй ещё раз.', jH: 'не получилось<br><em>добавить поездку</em>',
      door: 'код двери', unlocks: 'откроется', ci: 'заезд', co: 'выезд',
      near: 'рядом<br>с <em>домом</em>', nearP: 'пешком от твоей двери',
      rail: ['заявка', 'бронь', 'заезд', 'в квартире', 'выезд'],
    }
  : {
      title: 'trip — rega rega', desc: 'your booking, codes and wifi — all in one place.',
      emptyH: 'your trip<br><em>will appear here</em>',
      emptyP: "open the booking link from your host's message — or paste it here.",
      field: 'booking link or code', open: 'open', stays: 'see stays',
      bad: "we couldn't find that booking — check the link from your message.",
      offline: "you're offline — the booking needs a connection to open.",
      loading: 'opening your trip…',
      how: 'getting <em>in</em>', wifi: 'wifi', pass: 'password', addr: 'address', route: 'directions', mapOpen: 'open in maps',
      parking: 'parking', out: 'when you leave', full: 'photo guide',
      copy: 'copy', copied: 'copied', cached: 'saved copy — no connection',
      forget: 'remove this trip from this phone', forgetSure: 'sure? tap again',
      pending: 'waiting for confirmation', pendingP: 'codes and wifi appear once the host confirms the booking.',
      taken: 'this booking is already added to another account.',
      invite: 'add a companion', inviteP: 'we make a link — the trip opens on their phone too',
      inviteCopied: 'invite link copied', inviteErr: "couldn't create the invite — try again.",
      joining: 'adding the trip…', toTrip: 'to my trip',
      jUsed: 'this invite has already been used.', jExpired: 'this invite has expired — ask for a new one.',
      jOwn: 'this is your own booking — send the invite to your companion.', jNotFound: "we couldn't find that invite — check the link.",
      jNet: "you're offline — try again.", jH: "couldn't<br><em>add the trip</em>",
      door: 'door code', unlocks: 'unlocks', ci: 'check-in', co: 'checkout',
      near: 'near<br><em>home</em>', nearP: 'a walk from your door',
      rail: ['request', 'booked', 'check-in', 'staying', 'checkout'],
    };

// guide places with coordinates → «рядом с домом» (picked client-side by distance from the flat)
const { data: gp } = await supabase
  .from('guide_places')
  .select('slug,title,name,category,photos,image,lat,lng')
  .eq('status', 'published');
const NEAR = ((gp || []) as any[])
  .filter((p) => p.lat != null && p.lng != null && p.slug)
  .map((p) => ({
    s: p.slug,
    n: String(p.title || p.name || '').toLowerCase(),
    k: p.category,
    c: catLabel(p.category, lang),
    q: thumb((p.photos && p.photos[0]) || p.image || '', 320),
    la: p.lat,
    lo: p.lng,
  }));
// category colours for the stamps — from guideCats.ts, never duplicated
const CATS = Object.fromEntries(Object.keys(GUIDE_CATS).map((k) => [k, { c: catColor(k), t: catTint(k), d: catDark(k), o: false, s: catStyle(k) }]));
const ICONS = { copy: icon('copy', 17), check: icon('check', 17), arrow: icon('arrowRight', 22) };
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <AppHeader lang={lang} />
  <main class="tr-screen">
    <p class="tr-loading" id="trLoading">{T.loading}</p>

    <!-- no booking on this phone yet -->
    <section class="tr-empty" id="trEmpty" hidden>
      <span class="tr-empty__ic" set:html={icon('suitcase', 26)} />
      <h1 class="rr-display tr-empty__h" set:html={T.emptyH} />
      <p class="tr-empty__p">{T.emptyP}</p>
      <form class="tr-add" id="trAdd" novalidate>
        <input class="tr-add__field" id="trField" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={T.field} aria-label={T.field} />
        <button class="tr-add__btn" type="submit">{T.open}</button>
      </form>
      <p class="tr-add__err" id="trErr" role="alert" hidden></p>
      <a class="tr-empty__alt" href={`${BASE}/app/stays`}>{T.stays}</a>
    </section>

    <!-- join: an invite that could not be accepted -->
    <section class="tr-empty" id="trJoin" hidden>
      <span class="tr-empty__ic" set:html={icon('userPlus', 26)} />
      <h1 class="rr-display tr-empty__h" set:html={T.jH} />
      <p class="tr-empty__p" id="trJoinMsg"></p>
      <a class="tr-empty__alt" href={`${BASE}/app/trip`}>{T.toTrip}</a>
    </section>

    <!-- the trip -->
    <div class="tr-trip" id="trTrip" hidden>
      <header class="tr-hello tr-in">
        <p class="rr-kick" id="trKick"></p>
        <h1 class="rr-display tr-h1" id="trH1"></h1>
      </header>
      <p class="tr-note" id="trNote" hidden></p>
      <p class="tr-cached" id="trCached" hidden>{T.cached}</p>

      <!-- status line: заявка → бронь → заезд → в квартире → выезд -->
      <section class="tr-flow tr-card tr-in tr-d1">
        <div class="tr-flow__head"><b id="trFlowH"></b><span class="tr-meta" id="trFlowOp"></span></div>
        <ol class="tr-rail" id="trRail">
          {T.rail.map((l) => <li><i></i><span>{l}</span></li>)}
        </ol>
        <p class="tr-flow__note" id="trPendingNote" hidden>{T.pendingP}</p>
      </section>

      <!-- the apartment + dates -->
      <a class="tr-stay tr-card tr-in tr-d2" id="trStay">
        <span class="tr-stay__ph">
          <img id="trPhoto" alt="" hidden onload="this.classList.add('is-loaded')" />
          <span class="rr-tag rr-tag--home tr-stay__tag"><i></i><span id="trName"></span></span>
        </span>
        <span class="tr-dates">
          <span class="tr-dates__d"><span class="tr-dates__n"><b id="trCiN"></b><small id="trCiM"></small></span><span class="tr-meta">{T.ci}</span></span>
          <span class="tr-dates__mid" set:html={ICONS.arrow} />
          <span class="tr-dates__d tr-dates__d--r"><span class="tr-dates__n"><b id="trCoN"></b><small id="trCoM"></small></span><span class="tr-meta">{T.co}</span></span>
        </span>
        <span class="tr-meta tr-stay__sum" id="trDates"></span>
      </a>

      <!-- dark pass: door code + wifi (only what the backend returned) -->
      <section class="tr-pass tr-in tr-d3" id="trPass" hidden>
        <div id="trPassMain" hidden>
          <p class="tr-pass__k" id="trPassK"></p>
          <div class="tr-pass__code">
            <span class="tr-pass__num" id="trPassNum"></span>
            <button class="tr-cp tr-copy" type="button" id="trPassCp"><Fragment set:html={ICONS.copy} /><span data-l>{T.copy}</span></button>
          </div>
        </div>
        <div id="trPassLock" hidden>
          <p class="tr-pass__k" id="trLockK"></p>
          <p class="tr-pass__lock" id="trLockV"></p>
        </div>
        <div class="tr-kv" id="trKv"></div>
      </section>

      <!-- address -->
      <section class="tr-addr tr-card tr-in tr-d4" id="trAddrSec" hidden>
        <p class="rr-kick">{T.addr}</p>
        <p class="tr-addr__h" id="trAddrText"></p>
        <div class="tr-sub" id="trParkSec" hidden>
          <p class="tr-sub__h">{T.parking}</p>
          <ul class="tr-bullets" id="trPark"></ul>
        </div>
        <div class="tr-acts">
          <a class="tr-btn" id="trAddr" target="_blank" rel="noopener"><Fragment set:html={icon('navigation', 19)} />{T.route}</a>
          <a class="tr-btn tr-btn--light" id="trFull" target="_blank" rel="noopener"><Fragment set:html={icon('photo', 19)} />{T.full}</a>
        </div>
      </section>

      <!-- getting in: the host's steps -->
      <section class="tr-sec" id="trHowSec" hidden>
        <h2 class="rr-display tr-h2" set:html={T.how} />
        <ol class="tr-steps tr-card" id="trSteps"></ol>
      </section>

      <section class="tr-sec" id="trOutSec" hidden>
        <div class="tr-card tr-out">
          <p class="rr-kick">{T.out}</p>
          <p class="tr-text" id="trOut"></p>
        </div>
      </section>

      <!-- near home: guide places a walk from the door -->
      <section class="tr-sec" id="trNearSec" hidden>
        <div class="tr-sec__h"><h2 class="rr-display tr-h2" set:html={T.near} /><span class="tr-meta">{T.nearP}</span></div>
        <div class="tr-list tr-card" id="trNear"></div>
      </section>

      <section class="tr-sec tr-foot">
        <button class="tr-invite tr-card" id="trInvite" type="button" hidden>
          <span class="tr-invite__ic" set:html={icon('userPlus', 22)} />
          <span class="tr-invite__t"><b>{T.invite}</b><span class="tr-meta">{T.inviteP}</span></span>
          <span class="tr-invite__go" set:html={icon('plus', 18)} />
        </button>
        <button class="tr-forget" id="trForget" type="button">{T.forget}</button>
      </section>
    </div>
  </main>
  <p class="tr-toast" id="trToast" role="status" aria-live="polite" hidden>{T.copied}</p>

  <TabBar lang={lang} />

  <script is:inline define:vars={{ LANG: lang, T, MODE: mode, BASE, NEAR, CATS, ICONS }}>
    (function () {
      var RU = LANG === 'ru';
      var SB = 'https://qkzinjawtumhjbezlyog.supabase.co';
      var KEY = 'sb_publishable_R0NeSmTwX9qt0bxlHYj1AA_JIVRqsqU';
      // the full guest page (photos per step, welcome coupons) — operator links point here too
      var FULL = 'https://bre-instruction-deploy.vercel.app/?t=';
      var UUID = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
      var $ = function (id) { return document.getElementById(id); };
      var show = function (id) { ['trLoading', 'trEmpty', 'trTrip', 'trJoin'].forEach(function (x) { $(x).hidden = x !== id; }); };

      function rpc(name, token) {
        return fetch(SB + '/rest/v1/rpc/' + name, {
          method: 'POST',
          headers: { apikey: KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_token: token }),
        }).then(function (r) { if (!r.ok) throw new Error('rpc'); return r.json(); });
      }

      // booking + apartment (coords, photo) → one cached object
      function load(token) {
        return Promise.all([rpc('guest_instruction', token), rpc('guest_guide', token).catch(function () { return null; })])
          .then(function (res) {
            var gi = res[0], gg = res[1];
            if (!gi) return null;
            var apt = (gg && gg.apt) || {};
            var trip = Object.assign({}, gi, { token: token, apt: { slug: apt.slug || '', lat: apt.lat, lng: apt.lng, photo: '' } });
            if (!apt.slug) return trip;
            return fetch(SB + '/rest/v1/apartments_public?select=photos&slug=eq.' + encodeURIComponent(apt.slug), { headers: { apikey: KEY } })
              .then(function (r) { return r.ok ? r.json() : []; })
              .then(function (rows) { trip.apt.photo = (rows[0] && rows[0].photos && rows[0].photos[0]) || ''; return trip; })
              .catch(function () { return trip; });
          });
      }

      function save(trip) {
        try {
          localStorage.setItem('rr_trip', JSON.stringify(trip));
          localStorage.setItem('rr_trip_token', trip.token);
        } catch (e) {}
      }

      // --- dates (all date-only, Batumi calendar) ---
      function d(s) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s || '')); return m ? new Date(+m[1], m[2] - 1, +m[3]) : null; }
      var MON = RU ? ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря']
                   : ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
      var MON3 = RU ? ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек']
                    : ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
      function fmt(x) { return x ? x.getDate() + ' ' + MON[x.getMonth()] : ''; }
      function plural(n, one, few, many) { var a = n % 10, b = n % 100; return a === 1 && b !== 11 ? one : a >= 2 && a <= 4 && (b < 10 || b >= 20) ? few : many; }
      var now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Tbilisi' }));
      var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

      function text(o, base) { return (o && (o[base + (RU ? '_ru' : '_en')] || o[RU ? 'ru' : 'en'] || o[base + (RU ? '_en' : '_ru')] || o[RU ? 'en' : 'ru'])) || ''; }
      function strip(s) { return String(s || '').replace(/<br\s*\/?>/gi, ', ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(); }
      function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
      function photoUrl(src) { return /^https?:/.test(src) ? src : 'https://bre-instruction-deploy.vercel.app/' + String(src).replace(/^\//, ''); }
      // two-line display heading: first line plain, second italic (orange via --accent-c)
      function display(h, a, b) {
        h.textContent = a;
        h.appendChild(document.createElement('br'));
        h.appendChild(el('em', '', b));
      }
      // a copy button: value in data-copy, the label swaps to «скопировано» in place
      function copyBtn(cls, k, v) {
        var b = el('button', cls + ' tr-copy'); b.type = 'button'; b.setAttribute('data-copy', v);
        if (k != null) b.appendChild(el('span', 'tr-kv__k', k));
        var w = el('span', 'tr-kv__v');
        w.appendChild(el('span', '', v)).setAttribute('data-l', '');
        w.insertAdjacentHTML('beforeend', ICONS.copy);
        b.appendChild(w);
        return b;
      }

      function render(t, cached) {
        var ins = t.instructions || {};
        var open = t.state === 'open';
        var pend = t.state === 'pending';
        var ci = d(t.ci), co = d(t.co);
        var past = t.state === 'expired' || (co && today > co);
        var op = (t.operator && t.operator.name) || '';

        $('trNote').hidden = true;
        $('trInvite').hidden = true;
        bookingId = null;
        $('trCached').hidden = !cached;

        // --- hello: kick + «батуми через N дней» ---
        var name = String(t.guest || '').trim().split(/\s+/)[0].toLowerCase();
        var hi = RU ? (name ? 'привет, ' + name + '!' : 'привет!') : (name ? 'hi, ' + name + '!' : 'hi!');
        var dCi = ci ? Math.round((ci - today) / 864e5) : null;
        var dCo = co ? Math.round((co - today) / 864e5) : null;
        var kick, h;
        if (past) { kick = hi; h = RU ? ['поездка', 'завершена'] : ['trip', 'completed']; }
        else if (dCo === 0) { kick = hi; h = RU ? ['сегодня', 'выезд'] : ['checkout', 'today']; }
        else if (dCi != null && dCi < 0) { kick = hi; h = RU ? ['ты', 'в батуми'] : ["you're", 'in batumi']; }
        else {
          kick = pend ? (RU ? 'заявка отправлена' : 'request sent') : hi + (RU ? ' мы тебя ждём' : " we're waiting for you");
          if (dCi === 0) h = RU ? ['батуми', 'сегодня'] : ['batumi', 'today'];
          else if (dCi === 1) h = RU ? ['батуми', 'завтра'] : ['batumi', 'tomorrow'];
          else if (dCi != null) h = RU ? ['батуми через', dCi + ' ' + plural(dCi, 'день', 'дня', 'дней')] : ['batumi in', dCi + ' days'];
          else h = RU ? ['твоя', 'поездка'] : ['your', 'trip'];
        }
        $('trKick').textContent = kick;
        display($('trH1'), h[0], h[1]);

        // --- status line ---
        var idx = pend ? 1 : past ? 5 : dCo === 0 ? 4 : (dCi != null && dCi < 0) ? 3 : 2;
        var head = pend ? (op ? (RU ? T.pending + ' ' + op : 'waiting for ' + op + ' to confirm') : T.pending)
          : past ? (RU ? 'до встречи в батуми' : 'see you in batumi again')
          : idx === 4 ? (RU ? 'сегодня выезд' : 'checkout today')
          : idx === 3 ? (RU ? 'ты в квартире' : "you're in")
          : dCi === 0 ? (RU ? 'сегодня заезд' : 'check-in today')
          : (RU ? 'бронь подтверждена' : 'booking confirmed');
        $('trFlowH').textContent = head;
        $('trFlowOp').textContent = pend ? '' : op;
        Array.prototype.forEach.call($('trRail').children, function (li, i) {
          li.className = i < idx ? 'is-done' : i === idx ? 'is-now' : '';
        });
        $('trRail').style.setProperty('--p', String(Math.min(idx, 4) / 4));
        $('trPendingNote').hidden = !pend;

        // --- the apartment + dates ---
        $('trName').textContent = String(t.apt_title || t.apt_name || (RU ? 'квартира' : 'apartment')).toLowerCase();
        $('trCiN').textContent = ci ? ci.getDate() : '';
        $('trCiM').textContent = ci ? MON3[ci.getMonth()] : '';
        $('trCoN').textContent = co ? co.getDate() : '';
        $('trCoM').textContent = co ? MON3[co.getMonth()] : '';
        var nights = t.nights || (ci && co ? Math.round((co - ci) / 864e5) : 0);
        var bits = [];
        if (nights) bits.push(RU ? nights + ' ' + plural(nights, 'ночь', 'ночи', 'ночей') : nights + (nights === 1 ? ' night' : ' nights'));
        if (t.adults) bits.push(RU ? t.adults + ' ' + plural(t.adults, 'гость', 'гостя', 'гостей') : t.adults + (t.adults === 1 ? ' guest' : ' guests'));
        $('trDates').textContent = bits.join(' · ');
        $('trDates').hidden = !bits.length;
        if (t.apt && t.apt.photo) { $('trPhoto').src = t.apt.photo; $('trPhoto').hidden = false; }
        if (t.apt && t.apt.slug) $('trStay').href = BASE + '/app/stays/' + t.apt.slug; else $('trStay').removeAttribute('href');

        // --- pass: codes (value only inside the ci-2…co+1 window — the server blanks it otherwise) + wifi ---
        var steps = pend || past ? [] : (ins.steps || []);
        var codes = steps.filter(function (s) { return s.code; }).map(function (s) {
          return { k: strip(text(s.code, 'label')), v: s.code.value != null && s.code.value !== '' ? String(s.code.value) : '' };
        });
        var withVal = codes.filter(function (c) { return c.v; });
        var w = t.wifi || {};
        var net = w.net || w.name || w.ssid, pass = w.pass || w.password;
        var wifiOn = open && !pend && !past && (net || pass);
        var kv = $('trKv'); kv.innerHTML = '';
        $('trPassMain').hidden = !withVal.length;
        $('trPassLock').hidden = !!withVal.length || !codes.length || t.state !== 'pre';
        if (withVal.length) {
          var main = withVal[0];
          $('trPassK').textContent = main.k || T.door;
          var num = $('trPassNum');
          num.textContent = main.v;
          num.className = 'tr-pass__num' + (main.v.length > 6 ? ' is-long' : main.v.length > 4 ? ' is-mid' : '');
          $('trPassCp').setAttribute('data-copy', main.v);
          withVal.slice(1).forEach(function (c) { kv.appendChild(copyBtn('tr-kv__row', c.k || T.door, c.v)); });
        } else if (codes.length && t.state === 'pre') {
          $('trLockK').textContent = codes[0].k || T.door;
          $('trLockV').textContent = T.unlocks + ' ' + fmt(d(t.unlock_date));
        }
        if (wifiOn && net) kv.appendChild(copyBtn('tr-kv__row', T.wifi, String(net)));
        if (wifiOn && pass) kv.appendChild(copyBtn('tr-kv__row', T.pass, String(pass)));
        kv.hidden = !kv.children.length;
        $('trPass').hidden = $('trPassMain').hidden && $('trPassLock').hidden && kv.hidden;

        // --- address + parking + directions / full guide ---
        var addr = strip(text(ins, 'addr'));
        var map = (typeof ins.map_url === 'string' && /^https?:\/\//i.test(ins.map_url) ? ins.map_url : '') || (t.apt && t.apt.lat != null ? 'https://www.google.com/maps/dir/?api=1&destination=' + t.apt.lat + ',' + t.apt.lng : '');
        $('trAddrSec').hidden = pend || !(addr || map);
        $('trAddrText').textContent = addr || T.mapOpen;
        $('trAddr').hidden = !map;
        if (map) $('trAddr').href = map; else $('trAddr').removeAttribute('href');
        var park = $('trPark'); park.innerHTML = '';
        (ins.parking || []).forEach(function (p) { var x = strip(text(p, '')); if (x) park.appendChild(el('li', '', x)); });
        $('trParkSec').hidden = !park.children.length;
        $('trFull').href = FULL + t.token;
        $('trFull').hidden = pend;

        // --- getting in: text, the code inline, how, photos ---
        var list = $('trSteps');
        list.innerHTML = '';
        steps.forEach(function (s) {
          var li = el('li', 'tr-step');
          li.appendChild(el('p', 'tr-step__text', strip(text(s, ''))));
          if (s.code) {
            var c = s.code, label = strip(text(c, 'label'));
            if (c.value != null && c.value !== '') li.appendChild(copyBtn('tr-code', label, String(c.value)));
            else if (t.state === 'pre') {
              var lk = el('div', 'tr-code tr-code--locked');
              lk.appendChild(el('span', 'tr-kv__k', label));
              lk.appendChild(el('span', 'tr-code__lock', T.unlocks + ' ' + fmt(d(t.unlock_date))));
              li.appendChild(lk);
            }
            var how = strip(text(c, 'how'));
            if (how) li.appendChild(el('p', 'tr-step__how', how));
          }
          var ph = (s.photos || []).filter(function (p) { return p && p.src; });
          if (ph.length) {
            var row = el('div', 'tr-step__photos');
            ph.slice(0, 3).forEach(function (p) {
              var a = el('a', 'tr-step__photo'); a.href = photoUrl(p.src); a.target = '_blank'; a.rel = 'noopener';
              var img = el('img'); img.src = photoUrl(p.src); img.alt = strip(text(p, '')); img.loading = 'lazy';
              if (p.fit === 'contain') img.style.objectFit = 'contain';
              a.appendChild(img); row.appendChild(a);
            });
            li.appendChild(row);
          }
          list.appendChild(li);
        });
        $('trHowSec').hidden = !steps.length;

        var out = pend || past ? '' : strip(text(ins, 'checkout_return'));
        $('trOut').textContent = out;
        $('trOutSec').hidden = !out;

        // --- near home: up to 3 guide places within a 20-minute walk of the door ---
        var nearBox = $('trNear'); nearBox.innerHTML = '';
        if (!pend && !past && t.apt && t.apt.lat != null && window.rrTrip) {
          NEAR.map(function (p) { return { p: p, m: window.rrTrip.walkFrom(t.apt, p.la, p.lo) }; })
            .filter(function (x) { return x.m != null && x.m <= 20; })
            .sort(function (a, b) { return a.m - b.m; })
            .slice(0, 3)
            .forEach(function (x) {
              var p = x.p, cat = CATS[p.k] || null;
              var a = el('a', 'tr-row'); a.href = BASE + '/app/place/' + p.s;
              var th = el('span', 'tr-row__th');
              if (p.q) { var im = el('img'); im.src = p.q; im.alt = ''; im.loading = 'lazy'; th.appendChild(im); }
              a.appendChild(th);
              var tx = el('span', 'tr-row__t');
              tx.appendChild(el('b', '', p.n));
              var tag = el('span', 'rr-tag' + (cat && cat.o ? ' is-ring' : ''));
              if (cat) { tag.setAttribute('style', cat.s); }
              tag.appendChild(el('i')); tag.appendChild(el('span', '', p.c));
              tx.appendChild(tag);
              a.appendChild(tx);
              a.appendChild(el('span', 'tr-row__min', x.m + (RU ? ' мин' : ' min')));
              nearBox.appendChild(a);
            });
        }
        $('trNearSec').hidden = !nearBox.children.length;

        show('trTrip');
      }

      function fail(msg) { show('trEmpty'); $('trErr').textContent = msg; $('trErr').hidden = false; }

      function open(token, fromField, claim) {
        show('trLoading');
        load(token).then(function (trip) {
          if (!trip) {
            if (!fromField) { try { localStorage.removeItem('rr_trip'); localStorage.removeItem('rr_trip_token'); } catch (e) {} }
            return fail(T.bad);
          }
          save(trip);
          // booking mode for this page too (TripFlag only ran at load)
          var co = d(trip.co);
          if (co && now < new Date(co.getFullYear(), co.getMonth(), co.getDate() + 1)) document.documentElement.classList.add('has-trip');
          render(trip, false);
          account(trip, claim);
        }).catch(function () {
          var cached = null;
          try { cached = JSON.parse(localStorage.getItem('rr_trip') || 'null'); } catch (e) {}
          if (cached && cached.token === token) render(cached, true);
          else fail(T.offline);
        });
      }

      // ---------- account (only when signed in; signed out nothing below runs) ----------
      function authed(fn) {
        var go = function () { window.rrAuth.session().then(function (s) { fn(s ? window.rrAuth : null); }).catch(function () { fn(null); }); };
        if (window.rrAuth) go(); else addEventListener('rr-auth-ready', go, { once: true });
      }
      function loginTo(next) { location.href = BASE + '/app/login?next=' + encodeURIComponent(next); }
      function claimed(tok) { try { return (JSON.parse(localStorage.getItem('rr_claimed') || '[]')).indexOf(tok) > -1; } catch (e) { return false; } }
      function markClaimed(tok) {
        try {
          var a = JSON.parse(localStorage.getItem('rr_claimed') || '[]');
          if (a.indexOf(tok) < 0) a.push(tok);
          localStorage.setItem('rr_claimed', JSON.stringify(a.slice(-50)));
        } catch (e) {}
      }
      var bookingId = null;
      function toast(msg) { var t = $('trToast'); t.textContent = msg; t.hidden = false; clearTimeout(t._h); t._h = setTimeout(function () { t.hidden = true; }, 1800); }
      function setRole(role, id) {
        bookingId = id || bookingId;
        $('trInvite').hidden = !(role === 'owner' && bookingId != null);
      }

      // after a trip is shown: claim a ?t= link once per device, then learn our role (owner → invite)
      function account(trip, explicit) {
        authed(function (auth) {
          if (!auth) return;
          var tok = trip.token;
          var lookup = function () {
            auth.trips().then(function (list) {
              var m = (list || []).filter(function (x) { return x.guest_token === tok; })[0];
              if (m) markClaimed(tok);
              if (m && $('trTrip').hidden === false) setRole(m.role, m.booking_id);
            }).catch(function () {});
          };
          if (claimed(tok)) return lookup();
          auth.claim(tok).then(function (r) {
            if (r && r.ok) { markClaimed(tok); setRole(r.role, r.booking_id); if (r.role !== 'owner') lookup(); return; }
            var e = r && r.error;
            if (e === 'taken') { $('trNote').textContent = T.taken; $('trNote').hidden = false; lookup(); }
            else if (e === 'no_profile') { if (explicit) loginTo(BASE + '/app/trip?t=' + tok); }
            // network / not_found: stay quiet, the next visit tries again
          }).catch(function () {});
        });
      }

      $('trInvite').addEventListener('click', function () {
        if (bookingId == null || !window.rrAuth) return;
        var b = this; b.disabled = true;
        window.rrAuth.invite(bookingId).then(function (r) {
          b.disabled = false;
          if (!r || !r.ok || !r.code) return toast(T.inviteErr);
          var link = location.origin + BASE + '/app/trip/join?i=' + r.code;
          var copy = function () {
            if (navigator.clipboard) navigator.clipboard.writeText(link).then(function () { toast(T.inviteCopied); }).catch(function () { toast(T.inviteErr); });
            else toast(T.inviteErr);
          };
          if (navigator.share) navigator.share({ url: link }).catch(function (e) { if (!e || e.name !== 'AbortError') copy(); });
          else copy();
        }).catch(function () { b.disabled = false; toast(T.inviteErr); });
      });

      // /app/trip with nothing on this phone: the account's own trips — upcoming/current first
      function pick(list) {
        var ok = (list || []).filter(function (x) { return x.guest_token && d(x.ci) && d(x.co); });
        var up = ok.filter(function (x) { return d(x.co) >= today; }).sort(function (a, b) { return d(a.ci) - d(b.ci); });
        if (up.length) return up[0];
        return ok.sort(function (a, b) { return d(b.co) - d(a.co); })[0] || null;
      }

      function joinFail(code) {
        var map = { used: T.jUsed, expired: T.jExpired, own: T.jOwn, not_found: T.jNotFound };
        $('trJoinMsg').textContent = map[code] || T.jNet;
        show('trJoin');
      }
      function runJoin() {
        var code = (location.search.match(/[?&]i=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i) || [])[1];
        if (!code) return joinFail('not_found');
        code = code.toLowerCase();
        $('trLoading').textContent = T.joining;
        var jdone = false;
        setTimeout(function () { if (!jdone) joinFail('network'); }, 8000);
        authed(function (auth) {
          jdone = true;
          if (!auth) return loginTo(BASE + '/app/trip/join?i=' + code);
          auth.accept(code).then(function (r) {
            if (!r || !r.ok) {
              if (r && r.error === 'no_profile') return loginTo(BASE + '/app/trip/join?i=' + code);
              return joinFail(r && r.error);
            }
            return auth.trips().then(function (list) {
              var m = (list || []).filter(function (x) { return String(x.booking_id) === String(r.booking_id); })[0];
              if (!m || !m.guest_token) return joinFail('network');
              if (history.replaceState) history.replaceState(null, '', BASE + '/app/trip');
              markClaimed(m.guest_token);
              $('trLoading').textContent = T.loading;
              open(m.guest_token, false, false);
            });
          }).catch(function () { joinFail('network'); });
        });
      }

      // token: ?t= in the link, else the one saved on this phone, else (signed in) the account's trips
      var q = (new URLSearchParams(location.search).get('t') || '').match(UUID);
      var saved = '';
      try { saved = localStorage.getItem('rr_trip_token') || ''; } catch (e) {}
      if (MODE === 'join') runJoin();
      else if (q) { open(q[0], false, true); if (history.replaceState) history.replaceState(null, '', location.pathname); }
      else if (UUID.test(saved)) open(saved, false, false);
      else {
        var settled = false;
        var empty = function () { if (!settled) { settled = true; show('trEmpty'); } };
        setTimeout(empty, 4000);
        authed(function (auth) {
          if (!auth) return empty();
          auth.trips().then(function (list) {
            var m = pick(list);
            if (m && !settled) { settled = true; markClaimed(m.guest_token); open(m.guest_token, false, false); } else empty();
          }).catch(empty);
        });
      }

      $('trAdd').addEventListener('submit', function (e) {
        e.preventDefault();
        var m = $('trField').value.match(UUID);
        if (!m) { $('trErr').textContent = T.bad; $('trErr').hidden = false; return; }
        $('trErr').hidden = true;
        $('trField').blur();
        open(m[0], true, true);
      });

      // tap to copy: codes, wifi — the label turns into «скопировано» in place
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.tr-copy');
        if (!b) return;
        var v = b.getAttribute('data-copy');
        if (!v || !navigator.clipboard) return;
        navigator.clipboard.writeText(v).then(function () {
          var l = b.querySelector('[data-l]');
          if (!l) return;
          if (b._was == null) b._was = l.textContent;
          l.textContent = T.copied;
          b.classList.add('is-copied');
          var ic = b.querySelector('svg'); if (ic) ic.outerHTML = ICONS.check;
          clearTimeout(b._t);
          b._t = setTimeout(function () {
            l.textContent = b._was; b._was = null;
            b.classList.remove('is-copied');
            var ic2 = b.querySelector('svg'); if (ic2) ic2.outerHTML = ICONS.copy;
          }, 1400);
        }).catch(function () {});
      });

      // forget: two taps, no dialogs
      $('trForget').addEventListener('click', function () {
        var b = this;
        if (!b.classList.contains('is-sure')) {
          b.classList.add('is-sure'); b.textContent = T.forgetSure;
          setTimeout(function () { b.classList.remove('is-sure'); b.textContent = T.forget; }, 4000);
          return;
        }
        try { localStorage.removeItem('rr_trip'); localStorage.removeItem('rr_trip_token'); } catch (e) {}
        document.documentElement.classList.remove('has-trip');
        $('trField').value = '';
        $('trErr').hidden = true;
        setRole(null);
        show('trEmpty');
        window.scrollTo(0, 0);
      });
    })();
  </script>
</AppFull>
