---
// Native app "message the host" screen — one component for both languages (pages app/chat and
// ru/app/chat). The conversation itself (markup + script) is ChatCore.astro, shared with the
// website's messages page; this file only adds the app frame and the tab bar.
import AppFull from '../../layouts/AppFull.astro';
import ChatCore from './ChatCore.astro';
import TabBar from '../TabBar.astro';

export interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const T = lang === 'ru'
  ? { title: 'переписка с хозяином — rega rega', desc: 'переписка с хозяином квартиры в приложении rega rega.' }
  : { title: 'messages with your host — rega rega', desc: 'messages with your apartment host in the rega rega app.' };
---
<AppFull lang={lang} title={T.title} description={T.desc}>
  <ChatCore lang={lang} mode="app" />
  <TabBar lang={lang} />
</AppFull>
