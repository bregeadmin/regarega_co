---
// Shared bottom nav — floating glass bar (r3/01-guide.html), 4 tabs (guide / stays /
// concierge / profile), reused on every native app screen. Inactive tabs show the icon only
// (label kept for screen readers via aria-label); the active tab is a black capsule + label. In booking mode (html.has-trip, see TripFlag.astro) the second tab is
// "trip" instead of "stays": both are rendered, tabbar.css shows one. `lang` picks both the labels and the base path ("" vs "/ru"), so a
// screen never mixes languages and the tabs never jump between the EN and RU apps.
// Mobile-only (hidden ≥720px via tabbar.css). `site` marks the copy rendered by the web
// site layouts (Site/SiteRu): it stays hidden in a normal browser and only shows inside
// the app wrapper / installed PWA (html.in-app, set by an inline script in those layouts).
import '../styles/tabbar.css';

export interface Props { lang?: 'en' | 'ru'; site?: boolean }
const { lang = 'en', site = false } = Astro.props;
const isRu = lang === 'ru';
const base = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';
const path = Astro.url.pathname;
const isActive = (...needles: string[]) => needles.some((n) => path.includes(n));

// Real Tabler-icons "outline" path data (viewBox 0 0 24 24, stroke currentColor,
// stroke-width 2) — copied verbatim from now.astro's inline bottom bar.
const ICONS = {
  compass: '<path d="M8 16l2 -6l6 -2l-2 6l-6 2" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 3l0 2" /><path d="M12 19l0 2" /><path d="M3 12l2 0" /><path d="M19 12l2 0" />',
  bed: '<path d="M5 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M22 17v-3h-20" /><path d="M2 8v9" /><path d="M12 14h10v-2a3 3 0 0 0 -3 -3h-7v5" />',
  key: '<path d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0z" /><path d="M15 9h.01" />',
  message: '<path d="M3 20l1.3 -3.9c-2.324 -3.437 -1.426 -7.872 2.1 -10.374c3.526 -2.501 8.59 -2.296 11.845 .48c3.255 2.777 3.695 7.266 1.029 10.501c-2.666 3.235 -7.615 4.215 -11.574 2.293l-4.7 1" />',
};

const L = isRu
  ? { guide: 'гид', stays: 'жильё', trip: 'поездка', concierge: 'консьерж', profile: 'профиль', nav: 'нижняя навигация' }
  : { guide: 'guide', stays: 'stays', trip: 'trip', concierge: 'concierge', profile: 'profile', nav: 'bottom navigation' };

const TABS = [
  { key: 'guide', href: `${base}/app/now`, active: isActive('/app/now', '/app/guide', '/app/map', '/app/search', '/guide'), icon: ICONS.compass, label: L.guide },
  { key: 'stays', href: `${base}/app/stays`, active: isActive('/app/stays', '/stays'), icon: ICONS.bed, label: L.stays },
  { key: 'trip', href: `${base}/app/trip`, active: isActive('/app/trip'), icon: ICONS.key, label: L.trip },
  { key: 'concierge', href: `${base}/app/concierge`, active: isActive('/app/concierge'), icon: ICONS.message, label: L.concierge },
];

const profileHref = `${base}/app/profile`;
const profileActive = isActive('/app/profile');
---
<div class={`tabbar-fade${site ? ' tabbar-fade--site' : ''}`} aria-hidden="true"></div>
<nav class={`tabbar${site ? ' tabbar--site' : ''}`} aria-label={L.nav}>
  {TABS.map((t) => (
    <a
      class={`tabbar__item${t.active ? ' is-active' : ''}`}
      href={t.href}
      data-tab={t.key}
      aria-current={t.active ? 'page' : undefined}
      aria-label={t.label}
    >
      <svg class="tabbar__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
      <span class="tabbar__label" aria-hidden="true">{t.label}</span>
    </a>
  ))}
  <a
    class={`tabbar__item tabbar__item--avatar${profileActive ? ' is-active' : ''}`}
    href={profileHref}
    data-tab="profile"
    aria-current={profileActive ? 'page' : undefined}
    aria-label={L.profile}
  >
    <span class="tabbar__avatar" aria-hidden="true">
      <span class="tabbar__avatar__hole"></span>
    </span>
    <span class="tabbar__label" aria-hidden="true">{L.profile}</span>
  </a>
</nav>
