---
// Shared bottom nav — Jakub's r4 menu (rega-design-panel/r4/jakub/tabbar.html + kit.js):
// 4 tabs (guide / stays|trip / concierge / profile), every tab shows its icon + label, the
// active one sits under a dark capsule. The capsule is a separate layer that rides between
// tabs on a spring: tap → it travels to the tab at once while the next page loads; drag →
// it follows the finger, release → the nearest tab opens. Labels under the capsule turn white
// exactly along its edge: the capsule carries a white copy of the row inside a clip.
// Each tab is its own page, so on leaving the capsule position goes to sessionStorage
// (rr_pill) and the next page starts the capsule there and lets it arrive (see the inline
// script below) — together with @view-transition (styles/app-vt.css) and
// view-transition-name:tabbar the menu never "jumps" on a full page load.
// In booking mode (html.has-trip, see TripFlag.astro) the second tab is "trip" instead of
// "stays" (with the orange dot): both are rendered, tabbar.css shows one. `lang` picks both
// the labels and the base path ("" vs "/ru"), so a screen never mixes languages.
// Mobile-only (hidden ≥720px via tabbar.css). `site` marks the copy rendered by the web
// site layouts (Site/SiteRu): it stays hidden in a normal browser and only shows inside
// the app wrapper / installed PWA (html.in-app, set by an inline script in those layouts).
import '../styles/tabbar.css';

export interface Props { lang?: 'en' | 'ru'; site?: boolean }
const { lang = 'en', site = false } = Astro.props;
const isRu = lang === 'ru';
const base = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';
const path = Astro.url.pathname;
const isActive = (...needles: string[]) => needles.some((n) => path.includes(n));

// Real Tabler-icons "outline" path data (viewBox 0 0 24 24, stroke currentColor, stroke-width 2).
const ICONS = {
  compass: '<path d="M8 16l2 -6l6 -2l-2 6l-6 2" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 3l0 2" /><path d="M12 19l0 2" /><path d="M3 12l2 0" /><path d="M19 12l2 0" />',
  bed: '<path d="M5 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M22 17v-3h-20" /><path d="M2 8v9" /><path d="M12 14h10v-2a3 3 0 0 0 -3 -3h-7v5" />',
  key: '<path d="M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1 -4.069 0l-.301 -.301l-6.558 6.558a2 2 0 0 1 -1.239 .578l-.175 .008h-1.172a1 1 0 0 1 -.993 -.883l-.007 -.117v-1.172a2 2 0 0 1 .467 -1.284l.119 -.13l.414 -.414h2v-2h2v-2l2.144 -2.144l-.301 -.301a2.877 2.877 0 0 1 0 -4.069l2.643 -2.643a2.877 2.877 0 0 1 4.069 0z" /><path d="M15 9h.01" />',
  sparkles: '<path d="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2zm0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2zm-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6z" />',
  user: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 10a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />',
};

const L = isRu
  ? { guide: 'гид', stays: 'жильё', trip: 'поездка', concierge: 'консьерж', profile: 'профиль', nav: 'нижняя навигация' }
  : { guide: 'guide', stays: 'stays', trip: 'trip', concierge: 'concierge', profile: 'profile', nav: 'bottom navigation' };

// `i` = visible slot (stays and trip share slot 1 — only one of them is ever shown).
const TABS = [
  { key: 'guide', i: 0, href: `${base}/app/now`, active: isActive('/app/now', '/app/guide', '/app/map', '/app/search', '/guide'), icon: ICONS.compass, label: L.guide },
  { key: 'stays', i: 1, href: `${base}/app/stays`, active: isActive('/app/stays', '/stays'), icon: ICONS.bed, label: L.stays },
  { key: 'trip', i: 1, href: `${base}/app/trip`, active: isActive('/app/trip'), icon: ICONS.key, label: L.trip, dot: true },
  { key: 'concierge', i: 2, href: `${base}/app/concierge`, active: isActive('/app/concierge'), icon: ICONS.sparkles, label: L.concierge },
  { key: 'profile', i: 3, href: `${base}/app/profile`, active: isActive('/app/profile'), icon: ICONS.user, label: L.profile },
];
const activeTab = TABS.find((t) => t.active);
const activeI = activeTab ? activeTab.i : -1;
---
<div class={`tabbar-fade${site ? ' tabbar-fade--site' : ''}`} aria-hidden="true"></div>
<nav
  class={`tabbar${site ? ' tabbar--site' : ''}`}
  aria-label={L.nav}
  data-active={activeI >= 0 ? String(activeI) : undefined}
  style={`--x:${Math.max(0, activeI)}`}
>
  <div class="tabbar__row">
    {TABS.map((t) => (
      <a
        class={`tabbar__item${t.active ? ' is-active' : ''}`}
        href={t.href}
        data-tab={t.key}
        data-i={t.i}
        aria-current={t.active ? 'page' : undefined}
        draggable="false"
      >
        <svg class="tabbar__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
        <span class="tabbar__label">{t.label}</span>
        {t.dot && <i class="tabbar__dot" aria-hidden="true"></i>}
      </a>
    ))}
  </div>
  <div class="tabbar__pill" aria-hidden="true">
    <div class="tabbar__pill-bg"></div>
    <div class="tabbar__pill-clip">
      <div class="tabbar__pill-inv">
        {TABS.map((t) => (
          <span class="tabbar__item" data-tab={t.key}>
            <svg class="tabbar__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
            <span class="tabbar__label">{t.label}</span>
            {t.dot && <i class="tabbar__dot"></i>}
          </span>
        ))}
      </div>
    </div>
  </div>
</nav>
<script is:inline>
/* Capsule controller. Inline (parser-blocking, tiny) so the carried position is applied
   before the first paint of the new page — a deferred module would paint the capsule at its
   final tab first and then jump. All motion is the CSS transition on --x (tabbar.css). */
(function () {
  var navs = document.querySelectorAll('nav.tabbar');
  var bar = navs[navs.length - 1];
  if (!bar || bar.__rr) return;
  bar.__rr = 1;
  var KEY = 'rr_pill', EDGE = 20, SLOP = 6;
  var RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var row = bar.querySelector('.tabbar__row');
  var pill = bar.querySelector('.tabbar__pill');
  var invRow = bar.querySelector('.tabbar__pill-inv');
  var home = bar.hasAttribute('data-active') ? +bar.getAttribute('data-active') : -1;
  var active = home;
  var x = Math.max(0, home);

  var shown = function (list) { return [].filter.call(list, function (el) { return el.offsetWidth > 0; }); };
  var links = function () { return shown(row.querySelectorAll('a.tabbar__item')); };
  var invs = function () { return shown(invRow.querySelectorAll('.tabbar__item')); };
  var tw = function () { return row.getBoundingClientRect().width / 4 || 1; };
  var set = function (v) { x = v; bar.style.setProperty('--x', String(v)); };
  // where the capsule really is right now (mid-spring included), in tab units
  var cur = function () {
    try { return new DOMMatrix(getComputedStyle(pill).transform).m41 / tw(); } catch (e) { return x; }
  };
  var snap = function (fn) { bar.classList.add('is-snap'); fn(); bar.getBoundingClientRect(); bar.classList.remove('is-snap'); };

  // continue the previous page's motion: start where the capsule was when that page left
  function arrive() {
    var c = null;
    try { c = JSON.parse(sessionStorage.getItem(KEY) || 'null'); sessionStorage.removeItem(KEY); } catch (e) {}
    if (active < 0) return;
    if (c && !RM && Date.now() - c.t < 4000 && isFinite(c.x) && Math.abs(c.x - active) > 0.01) {
      snap(function () { set(c.x); });
      set(active);
    } else snap(function () { set(active); });
  }
  arrive();
  var remember = function () {
    if (!bar.hasAttribute('data-active') || !bar.offsetWidth) return;
    try { sessionStorage.setItem(KEY, JSON.stringify({ x: cur(), t: Date.now() })); } catch (e) {}
  };
  var navTimer = 0;
  // a visible sheet/dialog (aria-modal) during the page transition: keep the menu inside the
  // page snapshot, otherwise its own VT layer would paint above the dialog's scrim for ~240ms.
  // (FirstRun's .fr stays in the DOM with aria-modal but display:none — hence the rects check)
  var fade = bar.previousElementSibling;
  var vtName = function () {
    var open = [].some.call(document.querySelectorAll('[aria-modal="true"]:not([hidden])'), function (el) { return el.getClientRects().length > 0; });
    bar.style.viewTransitionName = open ? 'none' : '';
    if (fade && fade.classList.contains('tabbar-fade')) fade.style.viewTransitionName = open ? 'none' : '';
  };
  addEventListener('pageswap', vtName);
  addEventListener('pagereveal', vtName);
  addEventListener('pageswap', remember);
  addEventListener('pagehide', function () { clearTimeout(navTimer); remember(); });
  // back/forward cache: the page comes back with the capsule parked on the tab that was tapped
  function restore(ride) {
    clearTimeout(navTimer);
    active = home;
    if (home < 0) { bar.removeAttribute('data-active'); snap(function () { set(0); }); return; }
    bar.setAttribute('data-active', String(home));
    if (ride) set(home); else arrive();
  }
  addEventListener('pageshow', function (e) { if (e.persisted) restore(false); });

  function go(i) {
    var a = links()[i];
    if (!a) return;
    if (!bar.hasAttribute('data-active')) snap(function () { set(i); }); // no tab here: appear in place
    bar.setAttribute('data-active', String(i));
    set(i);
    if (a.pathname === location.pathname) { // already here (e.g. both stays/trip slots): stay put
      if (i === active) window.scrollTo({ top: 0, behavior: RM ? 'auto' : 'smooth' });
      settle();
      return;
    }
    active = i;
    // navigation aborted (offline, cancelled) and the page is still alive: go back to this page's tab
    clearTimeout(navTimer);
    navTimer = setTimeout(function () { restore(true); }, 8000);
    location.href = a.href;
  }
  function settle() { // back to the tab of this page (drag released on it / cancelled)
    if (active < 0) { bar.removeAttribute('data-active'); return; }
    bar.setAttribute('data-active', String(active));
    set(active);
  }

  // keyboard / plain taps arrive as a click on the link
  var muteClick = 0;
  bar.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a.tabbar__item');
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button > 0) return;
    if (a || Date.now() < muteClick) e.preventDefault();
    if (!a || Date.now() < muteClick) return;
    go(links().indexOf(a));
  });

  // drag: the capsule follows the finger, release → nearest tab
  var p0 = null, dragging = false, base = 0, pressed = null, dragTimer = 0;
  var clear = function (cls) { [].forEach.call(bar.querySelectorAll('.' + cls), function (el) { el.classList.remove(cls); }); };
  bar.addEventListener('pointerdown', function (e) {
    // one finger at a time; left 20px = native back swipe
    if (p0 || !e.isPrimary || e.button > 0 || e.clientX < EDGE) return;
    var r = row.getBoundingClientRect(), w = r.width / 4;
    var i = Math.min(3, Math.max(0, Math.floor((e.clientX - r.left) / w)));
    p0 = { x: e.clientX, left: r.left, w: w, id: e.pointerId };
    dragging = false;
    pressed = links()[i];
    if (pressed) pressed.classList.add('is-press');
  });
  bar.addEventListener('pointermove', function (e) {
    if (!p0 || e.pointerId !== p0.id) return;
    var dx = e.clientX - p0.x;
    if (!dragging) {
      if (Math.abs(dx) <= SLOP) return;
      dragging = true;
      clear('is-press');
      try { bar.setPointerCapture(e.pointerId); } catch (err) {}
      bar.classList.add('is-lift');
      base = (p0.x - p0.left) / p0.w - 0.5; // capsule centred under the finger
      if (!bar.hasAttribute('data-active')) { snap(function () { set(base); }); bar.setAttribute('data-active', ''); }
      // started off the capsule: it first springs under the finger (~140ms), then tracks it 1:1
      clearTimeout(dragTimer);
      dragTimer = setTimeout(function () { if (dragging) bar.classList.add('is-drag'); }, RM ? 0 : 140);
    }
    var v = base + dx / p0.w, max = 3;
    if (v < 0) v = -Math.pow(-v * p0.w, 0.7) / p0.w;          // rubber band at the ends
    if (v > max) v = max + Math.pow((v - max) * p0.w, 0.7) / p0.w;
    set(v);
    var n = Math.round(Math.min(max, Math.max(0, v)));
    links().forEach(function (b, k) { b.classList.toggle('is-near', k === n); });
    invs().forEach(function (b, k) { b.classList.toggle('is-near', k === n); });
  });
  var up = function (e) {
    if (!p0 || (e && e.pointerId !== p0.id)) return;
    var wasDrag = dragging, cancel = !e || e.type !== 'pointerup';
    p0 = null; dragging = false;
    clearTimeout(dragTimer);
    clear('is-press'); clear('is-near');
    bar.classList.remove('is-drag', 'is-lift');
    if (wasDrag) {
      muteClick = Date.now() + 400;
      var n = Math.round(Math.min(3, Math.max(0, x)));
      if (cancel || n === active) settle(); else go(n);
    }
  };
  bar.addEventListener('pointerup', up);
  bar.addEventListener('pointercancel', up);
  // our capture lost without pointerup → treat as cancel (ignore the link's implicit touch capture handing over)
  bar.addEventListener('lostpointercapture', function (e) { if (e.target === bar) up(e); });
  addEventListener('blur', function () { up(null); });
  bar.addEventListener('dragstart', function (e) { e.preventDefault(); });
})();
</script>
