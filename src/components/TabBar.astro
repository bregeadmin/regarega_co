---
// Mobile app-shell bottom tab bar — guide / map / stays / trip.
// Mobile-only (hidden ≥720px via tabbar.css); the existing <header class="topbar"> covers wide screens.
import '../styles/tabbar.css';

export interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const base = isRu ? '/ru/georgia/batumi' : '/georgia/batumi';
const path = Astro.url.pathname;

// Real Tabler-icons "outline" path data (viewBox 0 0 24 24, stroke currentColor, stroke-width 2).
const ICONS = {
  compass: '<path d="M8 16l2 -6l6 -2l-2 6l-6 2" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 3l0 2" /><path d="M12 19l0 2" /><path d="M3 12l2 0" /><path d="M19 12l2 0" />',
  map2: '<path d="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5" /><path d="M9 4v13" /><path d="M15 7v5.5" /><path d="M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879" /><path d="M19 18v.01" />',
  bed: '<path d="M5 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M22 17v-3h-20" /><path d="M2 8v9" /><path d="M12 14h10v-2a3 3 0 0 0 -3 -3h-7v5" />',
  route: '<path d="M3 19a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M19 7a2 2 0 1 0 0 -4a2 2 0 0 0 0 4" /><path d="M11 19h5.5a3.5 3.5 0 0 0 0 -7h-8a3.5 3.5 0 0 1 0 -7h4.5" />',
};

// The site has no dedicated map page yet — the map view lives inside /stays (list ↔ map toggle),
// so the "map" tab points there for now. `match` is kept distinct from stays' so the two tabs
// don't both light up on /stays; swap both to '/map' once a real map route ships.
const TABS = [
  { key: 'guide', href: `${base}/guide`, match: '/guide', icon: ICONS.compass, label: isRu ? 'гид' : 'guide' },
  { key: 'map', href: `${base}/stays#map`, match: '/map', icon: ICONS.map2, label: isRu ? 'карта' : 'map' },
  { key: 'stays', href: `${base}/stays`, match: '/stays', icon: ICONS.bed, label: isRu ? 'жильё' : 'stays' },
  { key: 'trip', href: `${base}/trip`, match: '/trip', icon: ICONS.route, label: isRu ? 'поездка' : 'trip' },
];
---
<nav class="tabbar" aria-label={isRu ? 'нижняя навигация' : 'bottom navigation'}>
  {TABS.map((t) => {
    const active = path.includes(t.match);
    return (
      <a
        class={`tabbar__item${active ? ' is-active' : ''}`}
        href={t.href}
        data-tab={t.key}
        aria-current={active ? 'page' : undefined}
      >
        <svg class="tabbar__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
        <span class="tabbar__label">{t.label}</span>
      </a>
    );
  })}
</nav>
<script is:inline>
// Вкладка «карта» = /stays#map: включаем карточный режим страницы жилья (кнопка #viewMap)
// и переносим подсветку на «карту» (сервер по URL этого не видит — hash не доходит).
(function () {
  function apply() {
    var isMap = location.hash === '#map';
    var bM = document.getElementById('viewMap'), bL = document.getElementById('viewList');
    if (isMap && bM) bM.click();
    else if (!isMap && bL && document.body.classList.contains('stays-map-open')) bL.click();
    var tM = document.querySelector('.tabbar__item[data-tab="map"]');
    var tS = document.querySelector('.tabbar__item[data-tab="stays"]');
    if (tM && tS && (tS.classList.contains('is-active') || tM.classList.contains('is-active'))) {
      tM.classList.toggle('is-active', isMap);
      tS.classList.toggle('is-active', !isMap);
    }
  }
  window.addEventListener('hashchange', apply);
  if (document.readyState !== 'loading') apply();
  else document.addEventListener('DOMContentLoaded', apply);
})();
</script>
