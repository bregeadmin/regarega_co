---
// Native app "stays" screen (RU) — mirrors app/stays.astro (EN): title_ru + RU plural forms.
import App from '../../../../../layouts/App.astro';
import '../../../../../styles/app-stays.css';
import { supabase, applyNames, type Apartment } from '../../../../../lib/supabase';
import { priceSym } from '../../../../../lib/price';
import { thumb } from '../../../../../lib/thumb';
import Punch from '../../../../../components/app/Punch.astro';

const LANG = 'ru' as const;
const BASE = '/ru/georgia/batumi';

const { data } = await supabase
  .from('apartments_public')
  .select('id,slug,title,title_ru,neighborhood,bedrooms,max_guests,price_from,price_currency,photos')
  .order('price_from', { ascending: true });
const apartments = ((data as Apartment[]) || []).map(applyNames);
const ph = (a: Apartment) => thumb((a.photos && a.photos[0]) || `https://picsum.photos/seed/${a.slug}/900/700`, 828);

const plural = (n: number, one: string, few: string, many: string) => { const m = n % 100, d = n % 10; if (m >= 11 && m <= 14) return many; if (d === 1) return one; if (d >= 2 && d <= 4) return few; return many; };
const facts = (a: Apartment) => [
  a.bedrooms === 0 ? 'студия' : `${a.bedrooms ?? 1} ${plural(a.bedrooms ?? 1, 'спальня', 'спальни', 'спален')}`,
  `до ${a.max_guests ?? 2} ${plural(a.max_guests ?? 2, 'гостя', 'гостей', 'гостей')}`,
  a.neighborhood ? a.neighborhood.toLowerCase() : null,
].filter(Boolean).join(' · ');
const n = apartments.length;
---
<App lang={LANG} title="жильё — rega rega" description="проверенные квартиры в батуми — выбери и забронируй напрямую.">
  <div class="sl-screen">
    <header class="sl-head">
      <h1 class="rr-display sl-head__h">где <em>жить</em></h1>
      <p class="sl-head__sub">{n} {plural(n, 'квартира', 'квартиры', 'квартир')} · бронь напрямую, отвечает живой человек</p>
    </header>
    <div class="sl-list">
      {apartments.map((a, i) => (
        <a class="sl-card" href={`${BASE}/app/stays/${a.slug}`} style={`--i:${Math.min(i, 6)}`}>
          <span class="sl-card__photo">
            <img src={ph(a)} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            <span class="sl-card__price">{a.price_from ? <><small>от</small> {priceSym(a.price_currency)}{a.price_from}<small> / ночь</small></> : 'по запросу'}</span>
            <Punch k="stay" s={a.slug} n={a.title} />
          </span>
          <span class="sl-card__body">
            <span class="sl-card__name">{(a.title_ru || a.title).toLowerCase()}</span>
            <span class="sl-card__meta">{facts(a)}</span>
          </span>
        </a>
      ))}
      {n === 0 && <p class="sl-empty">квартир пока нет</p>}
    </div>
  </div>
</App>
