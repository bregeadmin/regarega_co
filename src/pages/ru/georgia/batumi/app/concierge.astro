---
// Native app "concierge" screen — RU mirror. Identical copy to the EN-prefix twin at
// src/pages/georgia/batumi/app/concierge.astro (this screen's content is Russian-first
// regardless of URL prefix, the same way app/now.astro is) — the only difference is the
// TabBar routing base, which needs lang="ru" here so жильё/профиль point at their
// /ru/georgia/batumi siblings instead.
import AppFull from '../../../../../layouts/AppFull.astro';
import '../../../../../styles/app-shell.css';
import '../../../../../styles/app-concierge.css';
import AppHeader from '../../../../../components/AppHeader.astro';
import TabBar from '../../../../../components/TabBar.astro';

const ICONS = {
  sparkle: '<path d="M16 3l1.106 3.79a2 2 0 0 0 1.104 1.105l3.79 1.105l-3.79 1.106a2 2 0 0 0 -1.105 1.104l-1.105 3.79l-1.106 -3.79a2 2 0 0 0 -1.104 -1.105l-3.79 -1.105l3.79 -1.106a2 2 0 0 0 1.105 -1.104z" /><path d="M6 15l.673 2.303a1.5 1.5 0 0 0 1.024 1.024l2.303 .673l-2.303 .673a1.5 1.5 0 0 0 -1.024 1.024l-.673 2.303l-.673 -2.303a1.5 1.5 0 0 0 -1.024 -1.024l-2.303 -.673l2.303 -.673a1.5 1.5 0 0 0 1.024 -1.024z" />',
  send: '<path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" />',
};
---
<AppFull lang="ru" title="консьерж — rega rega" description="ии-консьерж батуми — спроси что угодно, собери вечер или найди место одним сообщением.">
  <AppHeader lang="ru" />
  <main class="cc-screen">
    <h1 class="cc-title">консьерж</h1>
    <p class="cc-sub">спроси rega — соберём вечер, найдём место или ответим на вопрос.</p>

    <div class="cc-prompt">
      <svg class="cc-prompt__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS.sparkle} />
      <span class="cc-prompt__text">спроси rega… собери вечер, найди кофейню</span>
      <span class="cc-prompt__send" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.send} />
      </span>
    </div>

    <nav class="cc-chips" aria-label="быстрые запросы">
      <button class="cc-chip" type="button">собери вечер</button>
      <button class="cc-chip" type="button">собери утро</button>
      <button class="cc-chip" type="button">что рядом</button>
      <button class="cc-chip" type="button">где поесть</button>
    </nav>

    <section class="cc-inbox" aria-label="твои переписки">
      <h2 class="cc-inbox__title">твои переписки</h2>
      <div class="cc-row cc-row--pinned">
        <span class="cc-row__avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.sparkle} />
        </span>
        <div class="cc-row__body">
          <p class="cc-row__name">rega · консьерж</p>
          <p class="cc-row__snippet">я тут, спроси что угодно</p>
        </div>
      </div>
      <div class="cc-row">
        <span class="cc-row__avatar cc-row__avatar--empty" aria-hidden="true"></span>
        <div class="cc-row__body">
          <p class="cc-row__name">новый чат</p>
          <p class="cc-row__snippet">пока пусто — начни с вопроса выше</p>
        </div>
      </div>
    </section>
  </main>

  <TabBar lang="ru" />
</AppFull>
