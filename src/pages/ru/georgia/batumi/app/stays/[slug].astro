---
// Native app apartment DETAIL screen (RU) — mirrors app/stays/[slug].astro (EN).
// See that file for the reuse notes (apt.css/date-sheet.css/rega-enhance.js/
// apt-booking.js, guests popover copied verbatim from pageScript). This one
// uses title_ru/summary_ru, RU plural forms and tAmenity — same conventions as
// src/pages/ru/georgia/batumi/stays/[slug].astro.
import App from '../../../../../../layouts/App.astro';
import '../../../../../../styles/apt.css';
import '../../../../../../styles/date-sheet.css';
import '../../../../../../styles/app-apt.css';
import { supabase, applyNames, type Apartment } from '../../../../../../lib/supabase';
import { stripEmoji } from '../../../../../../lib/text';
import { priceSym } from '../../../../../../lib/price';
import { tAmenity } from '../../../../../../lib/roomsRu';

const LANG = 'ru' as const;
const BASE = '/ru/georgia/batumi';

export async function getStaticPaths() {
  const { data } = await supabase
    .from('apartments_public')
    .select('id,slug,title,title_ru,summary,summary_ru,neighborhood,bedrooms,baths,max_guests,price_from,price_currency,photos,amenities');
  const apartments = ((data as Apartment[]) || []).map(applyNames);
  return apartments.map((apt) => ({ params: { slug: apt.slug }, props: { apt } }));
}

const { apt } = Astro.props as { apt: Apartment };
const photos = (apt.photos && apt.photos.length) ? apt.photos : ['https://picsum.photos/seed/' + apt.slug + '/1600/1000'];

const plural = (n: number, one: string, few: string, many: string) => { const m = n % 100, d = n % 10; if (m >= 11 && m <= 14) return many; if (d === 1) return one; if (d >= 2 && d <= 4) return few; return many; };
const bedsW = (n: number) => plural(n, 'спальня', 'спальни', 'спален');
const guestsW = (n: number) => plural(n, 'гость', 'гостя', 'гостей');
const bathsW = (n: number) => plural(n, 'ванная', 'ванные', 'ванных');

// Airbnb section labels glued into the text (EN labels — RU summaries fall back to the
// EN source where these appear) — same helper as the site RU detail page.
const ABNB_HEAD = /^(the space|guest access|other things to note|other details to note|the neighbou?rhood|getting around|getting there|interaction with guests|during your stay|registration number)\.?:?$/i;
const renderAbout = (raw: string) => {
  const out: string[] = []; let para: string[] = [];
  const flush = () => { if (para.length) { out.push(`<p>${para.join(' ')}</p>`); para = []; } };
  stripEmoji(raw).split(/\n/).map((l) => l.trim()).forEach((l) => {
    if (!l) { flush(); return; }
    if (ABNB_HEAD.test(l)) { flush(); out.push(`<h5 class="ab-head">${l.replace(/[:.]$/, '')}</h5>`); return; }
    para.push(l);
  });
  flush();
  return out.join('');
};
const summary = apt.summary_ru || apt.summary;
const aboutHtml = summary ? renderAbout(summary) : '';

const factParts = [
  apt.bedrooms === 0 ? 'студия' : `${apt.bedrooms ?? 1} ${bedsW(apt.bedrooms ?? 1)}`,
  `${apt.max_guests ?? 2} ${guestsW(apt.max_guests ?? 2)}`,
  apt.baths ? `${apt.baths} ${bathsW(apt.baths)}` : null,
  apt.neighborhood || null,
].filter(Boolean);

const aptBookCfg = JSON.stringify({
  id: apt.id, title: apt.title_ru || apt.title, maxGuests: apt.max_guests ?? 2,
  url: import.meta.env.PUBLIC_SUPABASE_URL || 'https://qkzinjawtumhjbezlyog.supabase.co',
  key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'sb_publishable_R0NeSmTwX9qt0bxlHYj1AA_JIVRqsqU',
  lang: 'ru',
  t: {
    months: ['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'],
    week: ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'],
    from: 'от', addDates: 'выбрать даты', minNights: 'минимум 2 ночи', minStay: 'минимум',
    nightsForms: ['ночь','ночи','ночей'],
    pickIn: '→ выберите заезд', pickOut: '→ теперь выезд',
    cleaning: 'уборка', total: 'итого', onRequest: 'по запросу',
    errDates: 'сначала выберите даты', errName: 'укажите имя', errContact: 'укажите контакт',
    errSend: 'не отправилось — напишите в telegram', send: '↗ отправить заявку', sending: 'отправляем…',
    placeholders: { telegram: '@username', whatsapp: '+995 …', email: 'name@email.com' },
  },
});
---
<App lang={LANG} title={(apt.title_ru || apt.title) + ' — rega rega'} description={stripEmoji(summary) || 'проверенная квартира в батуми.'}>
  <div class="napt-page">
    <div class="napt-gallery">
      <a class="napt-back" href={`${BASE}/app/stays`} aria-label="назад к жилью">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6" /></svg>
      </a>
      <div class="napt-gallery__scroll" id="naptGallery">
        {photos.map((p) => (
          <div class="napt-gallery__slide"><img src={p} alt={apt.title_ru || apt.title} loading="lazy" /></div>
        ))}
      </div>
      {photos.length > 1 && <div class="napt-gallery__count" id="naptGalleryCount">1 / {photos.length}</div>}
    </div>

    <div class="napt-head">
      <h1 class="napt-title">{apt.title_ru || apt.title}.</h1>
      <p class="napt-meta">{factParts.join('  ·  ')}</p>
    </div>

    {aboutHtml && (
      <div class="napt-section">
        <span class="napt-label">— о квартире</span>
        <div class="napt-about" set:html={aboutHtml} />
      </div>
    )}

    {apt.amenities && apt.amenities.length > 0 && (
      <div class="napt-section">
        <span class="napt-label">— удобства</span>
        <div class="napt-amenities">
          {apt.amenities.map((a) => (
            <div class="am"><span class="ic">✓</span> {tAmenity(a)}</div>
          ))}
        </div>
      </div>
    )}

    <div class="napt-section">
      <span class="napt-label">— бронь напрямую</span>
      <aside class="apt-book" id="aptBook" data-state="empty">
        <div class="ab-price">
          {apt.price_from ? (
            <div class="price"><em id="abFrom">от {priceSym(apt.price_currency)}{apt.price_from}</em> <span class="per" id="abPer">/ ночь</span></div>
          ) : (
            <div class="price"><em id="abFrom">по запросу</em> <span class="per" id="abPer" hidden>/ ночь</span></div>
          )}
          <span class="ab-save" id="abSave" hidden>≈10% дешевле, чем на airbnb</span>
        </div>
        <div class="book-form">
          <button class="date-trigger" id="dateTrigger" type="button">
            <span class="dt-label">— заезд | выезд</span>
            <span class="dt-val empty" id="dateVal">выбрать даты</span>
          </button>
          <button class="guest-trigger" id="guestTrigger" type="button">
            <span class="gt-label">— гости</span>
            <span class="gt-val" id="gtVal">2 гостя</span>
          </button>
        </div>
        <div class="ab-empty">
          <button class="ab-pick" id="abPick" type="button">выберите даты ↑</button>
          <ol class="book-steps">
            <li><span class="bs-n">1</span><span><b>выберите даты</b> — увидите точную цену</span></li>
            <li><span class="bs-n">2</span><span><b>отправьте заявку</b> — из вашего аккаунта</span></li>
            <li><span class="bs-n">3</span><span><b>ответим за час</b> — живой человек</span></li>
          </ol>
        </div>
        <form class="ab-form" id="abForm" novalidate>
          <div class="ab-summary" id="abSummary"></div>
          <div class="ab-to">
            <span class="ab-to-label">— куда вам ответить</span>
            <input class="ab-name" id="abName" type="text" placeholder="ваше имя" autocomplete="name" />
            <div class="ab-seg" id="abSeg">
              <button type="button" class="ab-seg-b active" data-ch="telegram">telegram</button>
              <button type="button" class="ab-seg-b" data-ch="whatsapp">whatsapp</button>
              <button type="button" class="ab-seg-b" data-ch="email">email</button>
            </div>
            <input class="ab-contact" id="abContact" type="text" placeholder="@username" />
          </div>
          <input type="text" id="abCompany" class="ab-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn-primary" id="abSend" type="submit">↗ отправить заявку</button>
          <p class="ab-reassure">ответим в течение часа — живой человек, не бот</p>
          <div class="ab-err" id="abErr"></div>
        </form>
        <div class="ab-sent">
          <div class="ab-sent-ic">✓</div>
          <h4>заявка отправлена!</h4>
          <p>оператор ответит в течение часа — живой человек, не бот. даты пока свободны для других — кто подтвердится, тот и бронирует.</p>
        </div>
      </aside>
    </div>
  </div>

  <!-- MOBILE BOOK BAR -->
  <div class="apt-book-bar" id="aptBookBar">
    <div class="bb-meta"><b>оставить заявку</b><span>живой человек · ответим за час</span></div>
    <button class="bb-btn" id="bookBtnMobile" type="button">↗ выбрать даты</button>
  </div>

  <!-- CALENDAR DROPDOWN -->
  <div class="cal-pop" id="calPop" hidden>
    <div class="cal-min" id="calMin" hidden></div>
    <div class="cal-head">
      <button class="cal-nav" id="calPrev" type="button" aria-label="previous month">‹</button>
      <div class="cal-months" id="calMonths"></div>
      <button class="cal-nav" id="calNext" type="button" aria-label="next month">›</button>
    </div>
    <div class="cal-legend">
      <span class="cal-leg"><span class="cl-free"></span>свободно · цена / ночь</span>
      <span class="cal-leg"><span class="cl-booked">00</span>занято</span>
      <span class="cal-leg-night" id="calNight">— выберите даты</span>
      <button class="cal-apply" id="calApply" type="button">готово →</button>
    </div>
  </div>

  <!-- GUEST DROPDOWN -->
  <div class="guest-pop" id="guestPop" hidden>
    <div class="gp-head">— кто приезжает</div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">взрослые</div><div class="gp-sub">— от 13 лет</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="adults-" type="button">−</button>
        <span class="gp-num" id="gpAdults">2</span>
        <button class="gp-btn" data-action="adults+" type="button">+</button>
      </div>
    </div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">дети</div><div class="gp-sub">— 2–12 лет</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="children-" type="button">−</button>
        <span class="gp-num" id="gpChildren">0</span>
        <button class="gp-btn" data-action="children+" type="button">+</button>
      </div>
    </div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">младенцы</div><div class="gp-sub">— до 2 лет</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="infants-" type="button">−</button>
        <span class="gp-num" id="gpInfants">0</span>
        <button class="gp-btn" data-action="infants+" type="button">+</button>
      </div>
    </div>
    <div class="gp-foot">
      <span class="gp-note">макс. 4 гостя</span>
      <button class="gp-apply" id="gpApply" type="button">применить →</button>
    </div>
  </div>

  <script is:inline set:html={'window.APT_BOOK=' + aptBookCfg + ';'}></script>
  <script is:inline>
    (function () {
      var scroller = document.getElementById('naptGallery');
      var counter = document.getElementById('naptGalleryCount');
      if (!scroller || !counter) return;
      var slides = scroller.querySelectorAll('.napt-gallery__slide').length;
      scroller.addEventListener('scroll', function () {
        var idx = Math.round(scroller.scrollLeft / scroller.clientWidth);
        counter.textContent = (Math.min(slides, idx + 1)) + ' / ' + slides;
      }, { passive: true });
    })();
  </script>
  <script is:inline>
    // GUESTS popover — copied verbatim from src/lib/aptDetailRu.ts's pageScript
    // (identical to the EN version: this widget's own labels are always English;
    // apt-booking.js's localizeGuests() re-writes them to Russian via APT_BOOK.lang).
    (function(){
      const trigger = document.getElementById('guestTrigger');
      const pop = document.getElementById('guestPop');
      const gtVal = document.getElementById('gtVal');
      const apply = document.getElementById('gpApply');
      if(!trigger||!pop)return;
      const state = {adults: 2, children: 0, infants: 0};
      const MAX = 4;
      const els = {adults: document.getElementById('gpAdults'), children: document.getElementById('gpChildren'), infants: document.getElementById('gpInfants')};

      function update(){
        els.adults.textContent = state.adults;
        els.children.textContent = state.children;
        els.infants.textContent = state.infants;
        pop.querySelectorAll('.gp-btn').forEach(btn=>{
          const [k, op] = [btn.dataset.action.replace(/[+\-]/,''), btn.dataset.action.slice(-1)];
          if(op === '-'){
            btn.disabled = (k === 'adults' ? state[k] <= 1 : state[k] <= 0);
          } else {
            const totalNoInfants = state.adults + state.children;
            btn.disabled = (k !== 'infants' && totalNoInfants >= MAX);
          }
        });
      }
      function syncLabel(){
        const total = state.adults + state.children;
        const parts = [`${total} guest${total===1?'':'s'}`];
        if(state.infants) parts.push(`${state.infants} infant${state.infants===1?'':'s'}`);
        gtVal.textContent = parts.join(' · ').toLowerCase();
      }
      function reposition(){
        if(pop.hidden) return;
        const rect = trigger.getBoundingClientRect();
        const top = Math.max(14, rect.bottom + 8);
        pop.style.top = top + 'px';
        pop.style.left = Math.max(14, Math.min(window.innerWidth - pop.offsetWidth - 14, rect.left)) + 'px';
      }
      function openPop(){
        pop.hidden = false;
        trigger.classList.add('active');
        reposition();
        update();
      }
      function closePop(){
        pop.hidden = true;
        trigger.classList.remove('active');
      }
      trigger.addEventListener('click', e=>{
        e.stopPropagation();
        if(pop.hidden) openPop(); else closePop();
      });
      pop.querySelectorAll('.gp-btn').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const [k, op] = [btn.dataset.action.replace(/[+\-]/,''), btn.dataset.action.slice(-1)];
          if(op === '+') state[k]++;
          else state[k]--;
          update();
        });
      });
      apply.addEventListener('click', ()=>{
        syncLabel();
        closePop();
      });
      document.addEventListener('click', e=>{
        if(!pop.hidden && !pop.contains(e.target) && !trigger.contains(e.target)) closePop();
      });
      window.addEventListener('scroll', reposition, {passive:true});
      window.addEventListener('resize', reposition);
      window.__getBookingGuests = ()=>state;
      update();
      syncLabel();
    })();
  </script>
  <script is:inline src="/apt-booking.js"></script>
  <script is:inline src="/rega-enhance.js"></script>
</App>
