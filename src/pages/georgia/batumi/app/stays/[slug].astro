---
// Native app apartment screen (EN) — the screen and the whole request-to-book flow live in
// components/app/StayScreen.astro (shared with the RU page).
import StayScreen from '../../../../../components/app/StayScreen.astro';
import { supabase, applyNames, type Apartment } from '../../../../../lib/supabase';

export async function getStaticPaths() {
  const { data } = await supabase
    .from('apartments_public')
    .select('id,slug,operator_id,title,title_ru,summary,summary_ru,neighborhood,bedrooms,baths,max_guests,price_from,price_currency,photos,amenities');
  const apartments = ((data as Apartment[]) || []).map(applyNames);
  return apartments.map((apt) => ({ params: { slug: apt.slug }, props: { apt } }));
}

const { apt } = Astro.props as { apt: Apartment };
---
<StayScreen lang="en" apt={apt} />
