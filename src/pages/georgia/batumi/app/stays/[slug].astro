---
// Native app apartment DETAIL screen — gallery, title, key facts, description,
// amenities, and the same booking flow as the site's stays/[slug].astro page:
// .apt-book / .apt-book-bar / .cal-pop / .guest-pop markup (styles: apt.css),
// the "native date sheet" shell (date-sheet.css + public/rega-enhance.js) and
// the exact booking script (public/apt-booking.js) that posts to /api/booking.
// No lightbox, no similar-flats, no location map, no FAQ/rules/CTA section —
// those are site-page extras this screen intentionally leaves out (see the
// final report). The guests popover script below is copied verbatim from
// src/lib/aptDetail.ts's pageScript (the "GUESTS" IIFE) rather than rewritten.
import App from '../../../../../layouts/App.astro';
import '../../../../../styles/apt.css';
import '../../../../../styles/date-sheet.css';
import '../../../../../styles/app-apt.css';
import { supabase, applyNames, type Apartment } from '../../../../../lib/supabase';
import { stripEmoji } from '../../../../../lib/text';
import { priceSym } from '../../../../../lib/price';

const LANG = 'en' as const;
const BASE = '/georgia/batumi';

export async function getStaticPaths() {
  const { data } = await supabase
    .from('apartments_public')
    .select('id,slug,title,summary,neighborhood,bedrooms,baths,max_guests,price_from,price_currency,photos,amenities');
  const apartments = ((data as Apartment[]) || []).map(applyNames);
  return apartments.map((apt) => ({ params: { slug: apt.slug }, props: { apt } }));
}

const { apt } = Astro.props as { apt: Apartment };
const photos = (apt.photos && apt.photos.length) ? apt.photos : ['https://picsum.photos/seed/' + apt.slug + '/1600/1000'];

// Airbnb exports glue section labels ("The space", "Guest access"…) into the text as
// bare lines; lift them into sub-headings — same helper as stays/[slug].astro.
const ABNB_HEAD = /^(the space|guest access|other things to note|other details to note|the neighbou?rhood|getting around|getting there|interaction with guests|during your stay|registration number)\.?:?$/i;
const renderAbout = (raw: string) => {
  const out: string[] = []; let para: string[] = [];
  const flush = () => { if (para.length) { out.push(`<p>${para.join(' ')}</p>`); para = []; } };
  stripEmoji(raw).split(/\n/).map((l) => l.trim()).forEach((l) => {
    if (!l) { flush(); return; }
    if (ABNB_HEAD.test(l)) { flush(); out.push(`<h5 class="ab-head">${l.replace(/[:.]$/, '')}</h5>`); return; }
    para.push(l);
  });
  flush();
  return out.join('');
};
const aboutHtml = apt.summary ? renderAbout(apt.summary) : '';

const factParts = [
  apt.bedrooms === 0 ? 'studio' : `${apt.bedrooms ?? 1} bed`,
  `${apt.max_guests ?? 2} guests`,
  apt.baths ? `${apt.baths} bath${apt.baths === 1 ? '' : 's'}` : null,
  apt.neighborhood || null,
].filter(Boolean);

const aptBookCfg = JSON.stringify({
  id: apt.id, title: apt.title, maxGuests: apt.max_guests ?? 2,
  url: import.meta.env.PUBLIC_SUPABASE_URL || 'https://qkzinjawtumhjbezlyog.supabase.co',
  key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'sb_publishable_R0NeSmTwX9qt0bxlHYj1AA_JIVRqsqU',
});
---
<App lang={LANG} title={apt.title + ' — rega rega'} description={stripEmoji(apt.summary) || 'a checked flat in batumi.'}>
  <div class="napt-page">
    <div class="napt-gallery">
      <a class="napt-back" href={`${BASE}/app/stays`} aria-label="back to stays">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6" /></svg>
      </a>
      <div class="napt-gallery__scroll" id="naptGallery">
        {photos.map((p) => (
          <div class="napt-gallery__slide"><img src={p} alt={apt.title} loading="lazy" /></div>
        ))}
      </div>
      {photos.length > 1 && <div class="napt-gallery__count" id="naptGalleryCount">1 / {photos.length}</div>}
    </div>

    <div class="napt-head">
      <h1 class="napt-title">{apt.title}.</h1>
      <p class="napt-meta">{factParts.join('  ·  ')}</p>
    </div>

    {aboutHtml && (
      <div class="napt-section">
        <span class="napt-label">— about this flat</span>
        <div class="napt-about" set:html={aboutHtml} />
      </div>
    )}

    {apt.amenities && apt.amenities.length > 0 && (
      <div class="napt-section">
        <span class="napt-label">— amenities</span>
        <div class="napt-amenities">
          {apt.amenities.map((a) => (
            <div class="am"><span class="ic">✓</span> {a}</div>
          ))}
        </div>
      </div>
    )}

    <div class="napt-section">
      <span class="napt-label">— book direct</span>
      <aside class="apt-book" id="aptBook" data-state="empty">
        <div class="ab-price">
          {apt.price_from ? (
            <div class="price"><em id="abFrom">from {priceSym(apt.price_currency)}{apt.price_from}</em> <span class="per" id="abPer">/ night</span></div>
          ) : (
            <div class="price"><em id="abFrom">price on request</em> <span class="per" id="abPer" hidden>/ night</span></div>
          )}
          <span class="ab-save" id="abSave" hidden>≈10% cheaper than airbnb</span>
        </div>
        <div class="book-form">
          <button class="date-trigger" id="dateTrigger" type="button">
            <span class="dt-label">— check in | check out</span>
            <span class="dt-val empty" id="dateVal">add dates</span>
          </button>
          <button class="guest-trigger" id="guestTrigger" type="button">
            <span class="gt-label">— guests</span>
            <span class="gt-val" id="gtVal">2 guests</span>
          </button>
        </div>
        <div class="ab-empty">
          <button class="ab-pick" id="abPick" type="button">pick your dates ↑</button>
          <ol class="book-steps">
            <li><span class="bs-n">1</span><span><b>pick dates</b> — see the exact price</span></li>
            <li><span class="bs-n">2</span><span><b>send a request</b> — from your account</span></li>
            <li><span class="bs-n">3</span><span><b>we answer in an hour</b> — a real person</span></li>
          </ol>
        </div>
        <form class="ab-form" id="abForm" novalidate>
          <div class="ab-summary" id="abSummary"></div>
          <div class="ab-to">
            <span class="ab-to-label">— where should we reply</span>
            <input class="ab-name" id="abName" type="text" placeholder="your name" autocomplete="name" />
            <div class="ab-seg" id="abSeg">
              <button type="button" class="ab-seg-b active" data-ch="telegram">telegram</button>
              <button type="button" class="ab-seg-b" data-ch="whatsapp">whatsapp</button>
              <button type="button" class="ab-seg-b" data-ch="email">email</button>
            </div>
            <input class="ab-contact" id="abContact" type="text" placeholder="@username" />
          </div>
          <input type="text" id="abCompany" class="ab-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn-primary" id="abSend" type="submit">↗ send request</button>
          <p class="ab-reassure">we answer within an hour — a real person, not a bot</p>
          <div class="ab-err" id="abErr"></div>
        </form>
        <div class="ab-sent">
          <div class="ab-sent-ic">✓</div>
          <h4>request sent!</h4>
          <p>the operator will reply within an hour — a real person, not a bot. the dates stay open for others until someone confirms — first to confirm books them.</p>
        </div>
      </aside>
    </div>
  </div>

  <!-- MOBILE BOOK BAR -->
  <div class="apt-book-bar" id="aptBookBar">
    <div class="bb-meta"><b>request to book</b><span>real person · answers in an hour</span></div>
    <button class="bb-btn" id="bookBtnMobile" type="button">↗ check dates</button>
  </div>

  <!-- CALENDAR DROPDOWN -->
  <div class="cal-pop" id="calPop" hidden>
    <div class="cal-min" id="calMin" hidden></div>
    <div class="cal-head">
      <button class="cal-nav" id="calPrev" type="button" aria-label="previous month">‹</button>
      <div class="cal-months" id="calMonths"></div>
      <button class="cal-nav" id="calNext" type="button" aria-label="next month">›</button>
    </div>
    <div class="cal-legend">
      <span class="cal-leg"><span class="cl-free"></span>free · price / night</span>
      <span class="cal-leg"><span class="cl-booked">00</span>booked</span>
      <span class="cal-leg-night" id="calNight">— pick dates</span>
      <button class="cal-apply" id="calApply" type="button">done →</button>
    </div>
  </div>

  <!-- GUEST DROPDOWN -->
  <div class="guest-pop" id="guestPop" hidden>
    <div class="gp-head">— who's coming</div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">adults</div><div class="gp-sub">— ages 13+</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="adults-" type="button">−</button>
        <span class="gp-num" id="gpAdults">2</span>
        <button class="gp-btn" data-action="adults+" type="button">+</button>
      </div>
    </div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">children</div><div class="gp-sub">— ages 2–12</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="children-" type="button">−</button>
        <span class="gp-num" id="gpChildren">0</span>
        <button class="gp-btn" data-action="children+" type="button">+</button>
      </div>
    </div>
    <div class="gp-row">
      <div class="gp-info"><div class="gp-title">infants</div><div class="gp-sub">— under 2</div></div>
      <div class="gp-ctrl">
        <button class="gp-btn" data-action="infants-" type="button">−</button>
        <span class="gp-num" id="gpInfants">0</span>
        <button class="gp-btn" data-action="infants+" type="button">+</button>
      </div>
    </div>
    <div class="gp-foot">
      <span class="gp-note">max 4 guests</span>
      <button class="gp-apply" id="gpApply" type="button">apply →</button>
    </div>
  </div>

  <script is:inline set:html={'window.APT_BOOK=' + aptBookCfg + ';'}></script>
  <script is:inline>
    // Photo counter for the gallery scroller — pure display, no lightbox (native
    // app screen keeps the gallery to a simple swipeable strip).
    (function () {
      var scroller = document.getElementById('naptGallery');
      var counter = document.getElementById('naptGalleryCount');
      if (!scroller || !counter) return;
      var slides = scroller.querySelectorAll('.napt-gallery__slide').length;
      scroller.addEventListener('scroll', function () {
        var idx = Math.round(scroller.scrollLeft / scroller.clientWidth);
        counter.textContent = (Math.min(slides, idx + 1)) + ' / ' + slides;
      }, { passive: true });
    })();
  </script>
  <script is:inline>
    // GUESTS popover — copied verbatim from src/lib/aptDetail.ts's pageScript
    // (the "GUESTS" section of the site apartment page's inline script), not
    // rewritten. apt-booking.js reads window.__getBookingGuests() on submit.
    (function(){
      const trigger = document.getElementById('guestTrigger');
      const pop = document.getElementById('guestPop');
      const gtVal = document.getElementById('gtVal');
      const apply = document.getElementById('gpApply');
      if(!trigger||!pop)return;
      const state = {adults: 2, children: 0, infants: 0};
      const MAX = 4;
      const els = {adults: document.getElementById('gpAdults'), children: document.getElementById('gpChildren'), infants: document.getElementById('gpInfants')};

      function update(){
        els.adults.textContent = state.adults;
        els.children.textContent = state.children;
        els.infants.textContent = state.infants;
        pop.querySelectorAll('.gp-btn').forEach(btn=>{
          const [k, op] = [btn.dataset.action.replace(/[+\-]/,''), btn.dataset.action.slice(-1)];
          if(op === '-'){
            btn.disabled = (k === 'adults' ? state[k] <= 1 : state[k] <= 0);
          } else {
            const totalNoInfants = state.adults + state.children;
            btn.disabled = (k !== 'infants' && totalNoInfants >= MAX);
          }
        });
      }
      function syncLabel(){
        const total = state.adults + state.children;
        const parts = [`${total} guest${total===1?'':'s'}`];
        if(state.infants) parts.push(`${state.infants} infant${state.infants===1?'':'s'}`);
        gtVal.textContent = parts.join(' · ').toLowerCase();
      }
      function reposition(){
        if(pop.hidden) return;
        const rect = trigger.getBoundingClientRect();
        const top = Math.max(14, rect.bottom + 8);
        pop.style.top = top + 'px';
        pop.style.left = Math.max(14, Math.min(window.innerWidth - pop.offsetWidth - 14, rect.left)) + 'px';
      }
      function openPop(){
        pop.hidden = false;
        trigger.classList.add('active');
        reposition();
        update();
      }
      function closePop(){
        pop.hidden = true;
        trigger.classList.remove('active');
      }
      trigger.addEventListener('click', e=>{
        e.stopPropagation();
        if(pop.hidden) openPop(); else closePop();
      });
      pop.querySelectorAll('.gp-btn').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const [k, op] = [btn.dataset.action.replace(/[+\-]/,''), btn.dataset.action.slice(-1)];
          if(op === '+') state[k]++;
          else state[k]--;
          update();
        });
      });
      apply.addEventListener('click', ()=>{
        syncLabel();
        closePop();
      });
      document.addEventListener('click', e=>{
        if(!pop.hidden && !pop.contains(e.target) && !trigger.contains(e.target)) closePop();
      });
      window.addEventListener('scroll', reposition, {passive:true});
      window.addEventListener('resize', reposition);
      window.__getBookingGuests = ()=>state;
      update();
      syncLabel();
    })();
  </script>
  <script is:inline src="/apt-booking.js"></script>
  <script is:inline src="/rega-enhance.js"></script>
</App>
