---
import TripFlag from '../components/TripFlag.astro';
import '../styles/app-vt.css';
import '../styles/app-saves.css';
// Full-bleed native app-shell layout: edge-to-edge screens that draw their OWN chrome
// (hero top bar, bottom nav, etc). NO site topbar, NO hamburger, NO black footer, and
// unlike layouts/App.astro also NO app-header / TabBar — the page owns 100% of the frame.
// Head essentials copied from App.astro (charset, viewport, fonts, manifest, SW) so this
// still installs/behaves like the rest of the app.
export interface Props { title?: string; description?: string; lang?: 'en' | 'ru' }
const {
  title = 'rega rega',
  description = 'the batumi guide — rega rega app.',
  lang = 'en',
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@300..900&family=Bricolage+Grotesque:opsz,wght@12..96,800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png?v=7" />
  <meta name="theme-color" content="#FAF7F0" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Rega Rega" />
  <script is:inline>/* iOS «потянуть-обновить» спрашивает: можно ли перезагрузить? Нельзя, пока открыта шторка/диалог или карта. */Object.defineProperty(window,'rrNoPullRefresh',{configurable:true,get:function(){var m=document.querySelectorAll('[aria-modal="true"]');for(var i=0;i<m.length;i++){if(m[i].getClientRects().length)return true;}return document.documentElement.hasAttribute('data-no-ptr');}});</script>
  <script is:inline>if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});}</script>
  <TripFlag />
  <!-- «мой батуми»: save marks on cards + sync (bump ?v= on change) -->
  <script is:inline src="/app-saves.js?v=1" defer></script>
</head>
<body class="app-full">
  <slot />
  <script>import "../lib/guestAuth";</script>
  <!-- big cards: card photo → gallery transition, gallery, photo viewer (bump ?v= on change: sw.js serves it stale-while-revalidate) -->
  <script is:inline src="/app-gallery.js?v=6"></script>
</body>
</html>
